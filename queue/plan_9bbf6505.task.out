│                                                                              │
│                                                                              │
│   import { cn } from "@/lib/utils";                                          │
│                                                                              │
│   interface DayOfWeekPickerProps {                                           │
│     value: number; // bitmask 0-127, bit 0=Mon .. bit 6=Sun                  │
│     onChange: (mask: number) => void;                                        │
│   }                                                                          │
│                                                                              │
│   const DAYS = [                                                             │
│     { label: "T2", index: 0 },                                               │
│     { label: "T3", index: 1 },                                               │
│     { label: "T4", index: 2 },                                               │
│     { label: "T5", index: 3 },                                               │
│     { label: "T6", index: 4 },                                               │
│     { label: "T7", index: 5 },                                               │
│     { label: "CN", index: 6 },                                               │
│   ];                                                                         │
│                                                                              │
│   export function DayOfWeekPicker({ value, onChange }:                       │
│   DayOfWeekPickerProps) {                                                    │
│     const toggle = (dayIndex: number) => {                                   │
│       onChange(value ^ (1 << dayIndex));                                     │
│     };                                                                       │
│                                                                              │
│     const isActive = (dayIndex: number) => {                                 │
│       return (value & (1 << dayIndex)) !== 0;                                │
│     };                                                                       │
│                                                                              │
│     return (                                                                 │
│       <div className="flex items-center gap-1.5">                            │
│         {DAYS.map((day) => (                                                 │
│           <button                                                            │
│             key={day.index}                                                  │
│             type="button"                                                    │
│             onClick={() => toggle(day.index)}                                │
│             className={cn(                                                   │
│               "flex h-9 w-9 items-center justify-center rounded-full         │
│   text-sm font-medium transition-colors",                                    │
│               "focus-visible:outline-none focus-visible:ring-2               │
│   focus-visible:ring-blue-500 focus-visible:ring-offset-2",                  │
│               isActive(day.index)                                            │
│                 ? "bg-blue-500 text-white"                                   │
│                 : "bg-slate-100 text-slate-600 hover:bg-slate-200"           │
│             )}                                                               │
│             aria-pressed={isActive(day.index)}                               │
│             aria-label={day.label}                                           │
│           >                                                                  │
│             {day.label}                                                      │
│           </button>                                                          │
│         ))}                                                                  │
│       </div>                                                                 │
│     );                                                                       │
│   }                                                                          │
│                                                                              │
