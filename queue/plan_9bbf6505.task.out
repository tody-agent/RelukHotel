│   import { useId } from "react";                                             │
│                                                                              │
│   interface DateRangePickerProps {                                           │
│     from: string | null; // ISO date string (YYYY-MM-DD) or null             │
│     to: string | null;                                                       │
│     onChange: (from: string | null, to: string | null) => void;              │
│   }                                                                          │
│                                                                              │
│   export function DateRangePicker({ from, to, onChange }:                    │
│   DateRangePickerProps) {                                                    │
│     const id = useId();                                                      │
│     const isUnlimited = from === null && to === null;                        │
│                                                                              │
│     const handleFromChange = (e: React.ChangeEvent<HTMLInputElement>) => {   │
│       const value = e.target.value || null;                                  │
│       onChange(value, to);                                                   │
│     };                                                                       │
│                                                                              │
│     const handleToChange = (e: React.ChangeEvent<HTMLInputElement>) => {     │
│       const value = e.target.value || null;                                  │
│       onChange(from, value);                                                 │
│     };                                                                       │
│                                                                              │
│     const handleUnlimitedChange = (checked: boolean) => {                    │
│       if (checked) {                                                         │
│         onChange(null, null);                                                │
│       } else {                                                               │
│         // Reset to today as a sensible default when unchecking              │
│         const today = new Date().toISOString().split("T")[0];                │
│         onChange(today, today);                                              │
│       }                                                                      │
│     };                                                                       │
│                                                                              │
│     return (                                                                 │
│       <div className="flex flex-col gap-3">                                  │
│         <div className="flex items-center gap-3">                            │
│           <div className="flex flex-col gap-1.5">                            │
│             <Label htmlFor={`${id}-from`} className="text-sm                 │
│   text-slate-600">                                                           │
│               Từ ngày                                                        │
│             </Label>                                                         │
│             <Input                                                           │
│               id={`${id}-from`}                                              │
│               type="date"                                                    │
│               value={from ?? ""}                                             │
│               onChange={handleFromChange}                                    │
│               disabled={isUnlimited}                                         │
│               className="w-40"                                               │
│             />                                                               │
│           </div>                                                             │
│           <div className="flex flex-col gap-1.5">                            │
│             <Label htmlFor={`${id}-to`} className="text-sm                   │
│   text-slate-600">                                                           │
│               Đến ngày                                                       │
│             </Label>                                                         │
│             <Input                                                           │
│               id={`${id}-to`}                                                │
│               type="date"                                                    │
│               value={to ?? ""}                                               │
│               onChange={handleToChange}                                      │
│               disabled={isUnlimited}                                         │
│               className="w-40"                                               │
│             />                                                               │
│           </div>                                                             │
│         </div>                                                               │
│         <div className="flex items-center gap-2">                            │
│           <Checkbox                                                          │
│             id={`${id}-unlimited`}                                           │
│             checked={isUnlimited}                                            │
│             onCheckedChange={(checked) =>                                    │
│               handleUnlimitedChange(checked === true)                        │
│             }                                                                │
│           />                                                                 │
│           <Label                                                             │
│             htmlFor={`${id}-unlimited`}                                      │
│             className="cursor-pointer text-sm text-slate-600"                │
│           >                                                                  │
│             Không giới hạn                                                   │
│           </Label>                                                           │
│         </div>                                                               │
│       </div>                                                                 │
│     );                                                                       │
│   }                                                                          │
