│           plan.hourly = Some(HourlyRate {                                    │
│               tiers: vec![HourlyRateTier {                                   │
│                   hour: 1,                                                   │
│                   price: dec!(100000),                                       │
│               }],                                                            │
│               max_hours: 4,                                                  │
│               is_cumulative: true,                                           │
│           });                                                                │
│           plan.overnight = Some(OvernightRate {                              │
│               base_price: dec!(250000),                                      │
│               checkin_start: NaiveTime::from_hms_opt(21, 0, 0).unwrap(),     │
│               checkout_deadline: NaiveTime::from_hms_opt(12, 0,              │
│   0).unwrap(),                                                               │
│               late_checkout_steps: vec![],                                   │
│               early_checkin_steps: vec![],                                   │
│           });                                                                │
│                                                                              │
│           let modes = plan.available_modes();                                │
│           assert_eq!(modes.len(), 2);                                        │
│           assert!(modes.contains(&BillingMode::Hourly));                     │
│           assert!(modes.contains(&BillingMode::Overnight));                  │
│       }                                                                      │
│                                                                              │
