│       #[test]                                                                │
│       fn test_surcharge_step_matches() {                                     │
│           let step = SurchargeStep {                                         │
│               from_minutes: 0,                                               │
│               to_minutes: Some(60),                                          │
│               kind: SurchargeKind::Fixed,                                    │
│               amount: dec!(30000),                                           │
│           };                                                                 │
│           assert!(step.matches(0));                                          │
│           assert!(step.matches(30));                                         │
│           assert!(step.matches(59));                                         │
│           assert!(!step.matches(60));                                        │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn test_surcharge_step_open_ended() {                                  │
│           let step = SurchargeStep {                                         │
│               from_minutes: 120,                                             │
│               to_minutes: None,                                              │
│               kind: SurchargeKind::Percent,                                  │
│               amount: dec!(50),                                              │
│           };                                                                 │
│           assert!(!step.matches(60));                                        │
│           assert!(step.matches(120));                                        │
│           assert!(step.matches(9999));                                       │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn test_surcharge_calculate_fixed() {                                  │
│           let step = SurchargeStep {                                         │
│               from_minutes: 0,                                               │
│               to_minutes: Some(60),                                          │
│               kind: SurchargeKind::Fixed,                                    │
│               amount: dec!(50000),                                           │
│           };                                                                 │
│           let result = step.calculate(dec!(200000));                         │
│           assert_eq!(result, dec!(50000));                                   │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn test_surcharge_calculate_percent() {                                │
│           let step = SurchargeStep {                                         │
│               from_minutes: 60,                                              │
│               to_minutes: None,                                              │
│               kind: SurchargeKind::Percent,                                  │
│               amount: dec!(25),                                              │
│           };                                                                 │
│           // 25% of 200,000 = 50,000                                         │
│           let result = step.calculate(dec!(200000));                         │
│           assert_eq!(result, dec!(50000));                                   │
│       }                                                                      │
│                                                                              │
