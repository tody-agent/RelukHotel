│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   /// Configuration for daily-rate (per-night) billing.                      │
│   ///                                                                        │
│   /// Standard hotel daily rate: check-in at `checkin_time`, checkout at     │
│   `checkout_time`.                                                           │
│   #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]             │
│   pub struct DailyRate {                                                     │
│       /// Base price per night (VND)                                         │
│       pub base_price: Decimal,                                               │
│       /// Standard check-in time (e.g., 14:00)                               │
│       pub checkin_time: NaiveTime,                                           │
│       /// Standard checkout time (e.g., 12:00)                               │
│       pub checkout_time: NaiveTime,                                          │
│       /// Surcharge steps for late checkout (quá giờ trả phòng theo ngày)    │
│       #[serde(default)]                                                      │
│       pub late_checkout_steps: Vec<SurchargeStep>,                           │
│       /// Surcharge steps for early check-in (vào trước giờ nhận phòng       │
│   theo ngày)                                                                 │
│       #[serde(default)]                                                      │
│       pub early_checkin_steps: Vec<SurchargeStep>,                           │
│   }                                                                          │
│                                                                              │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│   // Monthly Rate (giá theo tháng)                                           │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   /// Configuration for monthly-rate billing (trọn gói tháng).               │
│   #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]             │
│   pub struct MonthlyRate {                                                   │
│       /// Flat monthly price (VND)                                           │
│       pub base_price: Decimal,                                               │
│       /// Whether partial months are prorated daily                          │
│       #[serde(default)]                                                      │
│       pub prorate_partial: bool,                                             │
│   }                                                                          │
│                                                                              │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│   // Extra Person Surcharge                                                  │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   /// Surcharge when the number of guests exceeds the room's max             │
│   occupancy.                                                                 │
│   #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]             │
│   pub struct ExtraPersonSurcharge {                                          │
│       /// Max occupancy before surcharge kicks in                            │
│       pub max_occupancy: u32,                                                │
│       /// Surcharge per extra person per night/stay (VND)                    │
│       pub per_person: Decimal,                                               │
│   }                                                                          │
│                                                                              │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│   // Rate Plan (Bảng giá loại phòng)                                         │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   /// A complete rate plan for a room type.                                  │
│   ///                                                                        │
│   /// Contains all pricing configurations: hourly, overnight, daily,         │
│   monthly,                                                                   │
│   /// and associated surcharge rules. This is the central configuration      │
│   entity.                                                                    │
│   #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]                 │
│   pub struct RatePlan {                                                      │
│       /// Unique identifier for this rate plan                               │
│       pub id: String,                                                        │
│       /// Room type name (e.g., "Phòng Đơn", "Phòng VIP")                    │
│       pub room_type: String,                                                 │
│       /// Optional description                                               │
│       #[serde(default)]                                                      │
│       pub description: Option<String>,                                       │
│                                                                              │
│       /// Hourly rate configuration (None if hourly billing not supported)   │
│       #[serde(default)]                                                      │
│       pub hourly: Option<HourlyRate>,                                        │
│       /// Overnight rate configuration (None if overnight billing not        │
│   supported)                                                                 │
│       #[serde(default)]                                                      │
│       pub overnight: Option<OvernightRate>,                                  │
│       /// Daily rate configuration (None if daily billing not supported)     │
│       #[serde(default)]                                                      │
│       pub daily: Option<DailyRate>,                                          │
│       /// Monthly rate configuration (None if monthly billing not            │
│   supported)                                                                 │
│       #[serde(default)]                                                      │
│       pub monthly: Option<MonthlyRate>,                                      │
│                                                                              │
│       /// Extra person surcharge configuration                               │
│       #[serde(default)]                                                      │
│       pub extra_person: Option<ExtraPersonSurcharge>,                        │
│                                                                              │
│       /// Currency code (default: "VND")                                     │
│       #[serde(default = "default_currency")]                                 │
│       pub currency: String,                                                  │
│   }                                                                          │
│                                                                              │
│   fn default_currency() -> String {                                          │
│       "VND".to_string()                                                      │
│   }                                                                          │
│                                                                              │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│   // CalcInput (Đầu vào tính giá)                                            │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   /// Input parameters for the pricing calculation engine.                   │
│   #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]             │
│   pub struct CalcInput {                                                     │
│       /// The rate plan ID to use for calculation                            │
│       pub rate_plan_id: String,                                              │
│       /// Actual check-in datetime                                           │
│       pub checkin: NaiveDateTime,                                            │
│       /// Actual checkout datetime                                           │
│       pub checkout: NaiveDateTime,                                           │
│       /// Number of guests in the room                                       │
│       pub guest_count: u32,                                                  │
│       /// Force a specific billing mode (None = auto-detect based on         │
│   duration)                                                                  │
│       #[serde(default)]                                                      │
│       pub force_mode: Option<BillingMode>,                                   │
│       /// Discount percentage (0-100), applied after calculation             │
│       #[serde(default)]                                                      │
│       pub discount_percent: Option<Decimal>,                                 │
│       /// Whether discount applies only to room charge (not services)        │
│       #[serde(default)]                                                      │
│       pub discount_room_only: bool,                                          │
│   }                                                                          │
│                                                                              │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│   // CalcOutput (Kết quả tính giá)                                           │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   /// A single line item in the calculation breakdown.                       │
│   #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]             │
│   pub struct CalcLineItem {                                                  │
│       /// Description of this charge (e.g., "Giá theo giờ (3h)", "Phụ trội   │
│   quá giờ")                                                                  │
│       pub description: String,                                               │
│       /// The charge amount in VND                                           │
│       pub amount: Decimal,                                                   │
│       /// Category for grouping                                              │
│       pub category: LineItemCategory,                                        │
│   }                                                                          │
│                                                                              │
│   /// Category of a line item for display/grouping.                          │
│   #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]       │
│   #[serde(rename_all = "snake_case")]                                        │
│   pub enum LineItemCategory {                                                │
│       /// Base room charge                                                   │
│       RoomCharge,                                                            │
│       /// Surcharge (late checkout, early checkin, extra person)             │
│       Surcharge,                                                             │
│       /// Discount (negative amount)                                         │
│       Discount,                                                              │
│   }                                                                          │
│                                                                              │
│   /// Output of the pricing calculation engine.                              │
│   #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]             │
│   pub struct CalcOutput {                                                    │
│       /// The billing mode that was used                                     │
│       pub mode: BillingMode,                                                 │
│       /// Total duration of stay in minutes                                  │
│       pub duration_minutes: u64,                                             │
│       /// Number of billable units (hours for hourly, nights for             │
│   daily/overnight, months for monthly)                                       │
│       pub billable_units: u32,                                               │
│       /// Detailed breakdown of charges                                      │
│       pub line_items: Vec<CalcLineItem>,                                     │
│       /// Subtotal before discount (VND)                                     │
│       pub subtotal: Decimal,                                                 │
│       /// Discount amount (VND, positive number)                             │
│       pub discount: Decimal,                                                 │
│       /// Grand total after discount (VND)                                   │
│       pub total: Decimal,                                                    │
│       /// Currency code                                                      │
│       pub currency: String,                                                  │
│   }                                                                          │
│                                                                              │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│   // Impl blocks                                                             │
│   //                                                                         │
│   ────────────────────────────────────────────────────────────────────────   │
│   ─────                                                                      │
│                                                                              │
│   impl RatePlan {                                                            │
│       /// Create a new empty rate plan with just an ID and room type.        │
│       pub fn new(id: impl Into<String>, room_type: impl Into<String>) ->     │
│   Self {                                                                     │
│           Self {                                                             │
│               id: id.into(),                                                 │
│               room_type: room_type.into(),                                   │
│               description: None,                                             │
│               hourly: None,                                                  │
│               overnight: None,                                               │
│               daily: None,                                                   │
│               monthly: None,                                                 │
│               extra_person: None,                                            │
│               currency: default_currency(),                                  │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       /// Returns which billing modes are configured for this rate plan.     │
│       pub fn available_modes(&self) -> Vec<BillingMode> {                    │
│           let mut modes = Vec::new();                                        │
│           if self.hourly.is_some() {                                         │
│               modes.push(BillingMode::Hourly);                               │
│           }                                                                  │
│           if self.overnight.is_some() {                                      │
│               modes.push(BillingMode::Overnight);                            │
│           }                                                                  │
│           if self.daily.is_some() {                                          │
│               modes.push(BillingMode::Daily);                                │
│           }                                                                  │
│           if self.monthly.is_some() {                                        │
│               modes.push(BillingMode::Monthly);                              │
│           }                                                                  │
│           modes                                                              │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   impl CalcOutput {                                                          │
│       /// Create a new empty CalcOutput.                                     │
│       pub fn new(mode: BillingMode, currency: impl Into<String>) -> Self {   │
│           Self {                                                             │
│               mode,                                                          │
│               duration_minutes: 0,                                           │
│               billable_units: 0,                                             │
│               line_items: Vec::new(),                                        │
│               subtotal: Decimal::ZERO,                                       │
│               discount: Decimal::ZERO,                                       │
│               total: Decimal::ZERO,                                          │
│               currency: currency.into(),                                     │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       /// Add a line item and update subtotal.                               │
│       pub fn add_line_item(&mut self, item: CalcLineItem) {                  │
│           match item.category {                                              │
│               LineItemCategory::Discount => {                                │
│                   self.discount += item.amount.abs();                        │
│               }                                                              │
│               _ => {                                                         │
│                   self.subtotal += item.amount;                              │
│               }                                                              │
│           }                                                                  │
│           self.line_items.push(item);                                        │
│           self.total = self.subtotal - self.discount;                        │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   impl SurchargeStep {                                                       │
│       /// Check if a given number of overtime minutes falls within this      │
│   step.                                                                      │
│       pub fn matches(&self, minutes: u32) -> bool {                          │
│           let above_lower = minutes >= self.from_minutes;                    │
│           let below_upper = match self.to_minutes {                          │
│               Some(upper) => minutes < upper,                                │
│               None => true, // open-ended                                    │
│           };                                                                 │
│           above_lower && below_upper                                         │
│       }                                                                      │
│                                                                              │
│       /// Calculate the surcharge amount given the base rate (used when      │
│   kind is Percent).                                                          │
│       pub fn calculate(&self, base_rate: Decimal) -> Decimal {               │
│           match self.kind {                                                  │
│               SurchargeKind::Fixed => self.amount,                           │
│               SurchargeKind::Percent => {                                    │
│                   (base_rate * self.amount) / Decimal::from(100)             │
│               }                                                              │
│           }                                                                  │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
