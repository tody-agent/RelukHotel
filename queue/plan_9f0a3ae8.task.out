│                                                                              │
│   use crate::overnights::{compute_overnights, compute_overnights_simple,     │
│   OvernightConfig, OvernightResult};                                         │
│   use chrono::NaiveDateTime;                                                 │
│   use tauri::command;                                                        │
│                                                                              │
│   #[command]                                                                 │
│   pub fn cmd_compute_overnights(                                             │
│       checkin: String,                                                       │
│       checkout: String,                                                      │
│       start_hour: Option<u32>,                                               │
│       end_hour: Option<u32>,                                                 │
│       min_minutes: Option<u32>,                                              │
│   ) -> Result<OvernightResult, String> {                                     │
│       let checkin_dt = NaiveDateTime::parse_from_str(&checkin,               │
│   "%Y-%m-%dT%H:%M:%S")                                                       │
│           .or_else(|_| NaiveDateTime::parse_from_str(&checkin, "%Y-%m-%d     │
│   %H:%M:%S"))                                                                │
│           .map_err(|e| format!("Invalid checkin datetime: {}", e))?;         │
│                                                                              │
│       let checkout_dt = NaiveDateTime::parse_from_str(&checkout,             │
│   "%Y-%m-%dT%H:%M:%S")                                                       │
│           .or_else(|_| NaiveDateTime::parse_from_str(&checkout, "%Y-%m-%d    │
│   %H:%M:%S"))                                                                │
│           .map_err(|e| format!("Invalid checkout datetime: {}", e))?;        │
│                                                                              │
│       let config = OvernightConfig {                                         │
│           start_hour: start_hour.unwrap_or(22),                              │
│           end_hour: end_hour.unwrap_or(6),                                   │
│           min_minutes: min_minutes.unwrap_or(0),                             │
│       };                                                                     │
│                                                                              │
│       Ok(compute_overnights(checkin_dt, checkout_dt, &config))               │
│   }                                                                          │
│                                                                              │
│   #[command]                                                                 │
│   pub fn cmd_compute_overnights_simple(                                      │
│       checkin: String,                                                       │
│       checkout: String,                                                      │
│       start_hour: Option<u32>,                                               │
│   ) -> Result<u32, String> {                                                 │
│       let checkin_dt = NaiveDateTime::parse_from_str(&checkin,               │
│   "%Y-%m-%dT%H:%M:%S")                                                       │
│           .or_else(|_| NaiveDateTime::parse_from_str(&checkin, "%Y-%m-%d     │
│   %H:%M:%S"))                                                                │
│           .map_err(|e| format!("Invalid checkin datetime: {}", e))?;         │
│                                                                              │
│       let checkout_dt = NaiveDateTime::parse_from_str(&checkout,             │
│   "%Y-%m-%dT%H:%M:%S")                                                       │
│           .or_else(|_| NaiveDateTime::parse_from_str(&checkout, "%Y-%m-%d    │
│   %H:%M:%S"))                                                                │
│           .map_err(|e| format!("Invalid checkout datetime: {}", e))?;        │
│                                                                              │
│       Ok(compute_overnights_simple(                                          │
│           checkin_dt,                                                        │
│           checkout_dt,                                                       │
│           start_hour.unwrap_or(22),                                          │
│       ))                                                                     │
│   }                                                                          │
│                                                                              │
│                                                                              │
│  --------------------------------------------------------------------------  │
│                                                                              │
│  Hướng dẫn gắn code                                                          │
│                                                                              │
│  1. Tạo file module                                                          │
│                                                                              │
│                                                                              │
│   src-tauri/crates/pricing/src/overnights.rs   ← Code chính (file đầu tiên   │
│   ở trên)                                                                    │
│                                                                              │
│                                                                              │
│  2. Đăng ký module trong lib.rs                                              │
│                                                                              │
│  Mở src-tauri/crates/pricing/src/lib.rs và thêm:                             │
│                                                                              │
│                                                                              │
│   pub mod overnights;                                                        │
│   pub use overnights::*;                                                     │
│                                                                              │
│                                                                              │
│  3. Đăng ký Tauri commands                                                   │
│                                                                              │
│  Trong src-tauri/src/main.rs (hoặc lib.rs tùy cấu trúc Tauri 2):             │
│                                                                              │
│                                                                              │
│   use pricing::commands::{cmd_compute_overnights,                            │
│   cmd_compute_overnights_simple};                                            │
│                                                                              │
│   // Trong builder:                                                          │
│   tauri::Builder::default()                                                  │
│       .invoke_handler(tauri::generate_handler![                              │
│           // ... other commands                                              │
│           cmd_compute_overnights,                                            │
│           cmd_compute_overnights_simple,                                     │
│       ])                                                                     │
│                                                                              │
│                                                                              │
│  4. Dependencies (Cargo.toml của pricing crate)                              │
│                                                                              │
│                                                                              │
│   [dependencies]                                                             │
│   chrono = { version = "0.4", features = ["serde"] }                         │
│   serde = { version = "1", features = ["derive"] }                           │
│                                                                              │
│                                                                              │
│  5. Gọi từ Frontend (React/TypeScript)                                       │
│                                                                              │
│                                                                              │
│   import { invoke } from '@tauri-apps/api/core';                             │
│                                                                              │
│   // Detailed computation                                                    │
│   const result = await invoke('cmd_compute_overnights', {                    │
│     checkin: '2025-01-15T20:00:00',                                          │
│     checkout: '2025-01-17T08:00:00',                                         │
│     startHour: 22,                                                           │
│     endHour: 6,                                                              │
│     minMinutes: 0,                                                           │
│   });                                                                        │
│   // result = { count: 2, has_partial: false, partial_minutes: 0, nights:    │
│   [...] }                                                                    │
│                                                                              │
│   // Simple count                                                            │
│   const nights = await invoke('cmd_compute_overnights_simple', {             │
│     checkin: '2025-01-15T20:00:00',                                          │
│     checkout: '2025-01-17T08:00:00',                                         │
│     startHour: 22,                                                           │
│   });                                                                        │
│   // nights = 2                                                              │
│                                                                              │
