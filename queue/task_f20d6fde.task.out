│                       extra_guest_fee_waived: false,                         │
│                       // request true thắng default false                    │
│                       service_fee_waived: true,                              │
│                       // fallback default false                              │
│                       tax_fee_waived: false,                                 │
│                   },                                                         │
│               }                                                              │
│           );                                                                 │
