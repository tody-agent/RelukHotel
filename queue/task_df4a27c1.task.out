│       pub base_price: i64,                                                   │
│       pub nights: i64,                                                       │
│                                                                              │
│       pub adults: i64,                                                       │
│       pub children: i64,                                                     │
│                                                                              │
│       pub extra_adults: i64,                                                 │
│       pub extra_adults_fee: i64,                                             │
│                                                                              │
│       pub extra_children: i64,                                               │
│       pub extra_child_fee: i64,                                              │
│                                                                              │
│       pub extra_bed: i64,                                                    │
│       pub extra_bed_fee: i64,                                                │
│                                                                              │
│       pub discount_percent: f64,                                             │
│       pub discount_amount: i64,                                              │
│                                                                              │
│       pub service_charge_percent: f64,                                       │
│       pub vat_percent: f64,                                                  │
│                                                                              │
│       pub holiday_surcharge: i64,                                            │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, serde::Serialize, serde::Deserialize, PartialEq)]   │
│   pub struct PricingBreakdown {                                              │
│       pub gross_base: i64,                                                   │
│       pub discount_total: i64,                                               │
│       pub surcharge_total: i64,                                              │
│       pub service_fee: i64,                                                  │
│       pub vat: i64,                                                          │
│       pub final_price: i64,                                                  │
│   }                                                                          │
│                                                                              │
│   fn round_money(value: f64) -> i64 {                                        │
│       value.round() as i64                                                   │
│   }                                                                          │
│                                                                              │
│   pub fn calculate_price(input: &PricingInput) -> PricingBreakdown {         │
│       let gross_base = input.base_price * input.nights;                      │
│                                                                              │
│       let discount_percent_value =                                           │
│           round_money((gross_base as f64) * (input.discount_percent /        │
│   100.0));                                                                   │
│       let discount_total = discount_percent_value + input.discount_amount;   │
│                                                                              │
│       let extra_adult_surcharge = input.extra_adults *                       │
│   input.extra_adults_fee * input.nights;                                     │
│       let extra_child_surcharge = input.extra_children *                     │
│   input.extra_child_fee * input.nights;                                      │
│       let extra_bed_surcharge = input.extra_bed * input.extra_bed_fee *      │
│   input.nights;                                                              │
│                                                                              │
│       let surcharge_total = extra_adult_surcharge                            │
│           + extra_child_surcharge                                            │
│           + extra_bed_surcharge                                              │
│           + input.holiday_surcharge;                                         │
│                                                                              │
│       let subtotal_before_tax = gross_base - discount_total +                │
│   surcharge_total;                                                           │
│                                                                              │
│       let service_fee = round_money(                                         │
│           (subtotal_before_tax as f64) * (input.service_charge_percent /     │
│   100.0)                                                                     │
│       );                                                                     │
│                                                                              │
│       let vat_base = subtotal_before_tax + service_fee;                      │
│       let vat = round_money((vat_base as f64) * (input.vat_percent /         │
│   100.0));                                                                   │
│                                                                              │
│       let final_price = subtotal_before_tax + service_fee + vat;             │
│                                                                              │
│       PricingBreakdown {                                                     │
│           gross_base,                                                        │
│           discount_total,                                                    │
│           surcharge_total,                                                   │
│           service_fee,                                                       │
│           vat,                                                               │
│           final_price,                                                       │
│       }                                                                      │
│   }                                                                          │
