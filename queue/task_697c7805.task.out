│   #[cfg(test)]                                                               │
│   mod test_d2_dynamic_pricing {                                              │
│       use crate::pricing::engine::calculate_dynamic_price;                   │
│       use crate::pricing::models::*;                                         │
│                                                                              │
│       /// Helper: tạo config dynamic mặc định cho test                       │
│       fn default_dynamic_config() -> DynamicPricingConfig {                  │
│           DynamicPricingConfig {                                             │
│               base_price: 500_000.0,          // 500k VND base               │
│               occupancy_rate: 0.5,            // 50% occupancy               │
│               surge_threshold: 0.7,           // Tăng giá từ 70%             │
│               max_multiplier: 2.0,            // Tối đa gấp đôi              │
│               is_peak_day: false,                                            │
│               peak_day_multiplier: 1.3,       // +30% ngày lễ                │
│               last_minute_discount_pct: 15.0, // -15% last minute            │
│               is_last_minute: false,                                         │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn d2_01_normal_occupancy_no_surge() {                                 │
│           // Occupancy 50% < threshold 70% => không tăng giá                 │
