│       fn d2_02_high_occupancy_surge_pricing() {                              │
│           // Occupancy 90% > threshold 70% => surge                          │
│           let mut config = default_dynamic_config();                         │
│           config.occupancy_rate = 0.9;                                       │
│                                                                              │
│           let result = calculate_dynamic_price(&config);                     │
│                                                                              │
│           // surge_progress = (0.9 - 0.7) / (1.0 - 0.7) = 0.667              │
│           // multiplier = 1.0 + 0.667 * (2.0 - 1.0) = 1.667                  │
│           // surge_amount = 500k * 0.667 = 333,333                           │
│           // total = 500k + 333,333 = 833,333 => rounded = 833,333           │
│           let expected = (500_000.0 * (1.0 + (0.2 / 0.3) * 1.0)).round();    │
│           assert_eq!(result.final_price, expected);                          │
│           assert!(result.final_price > 500_000.0);                           │
│       }                                                                      │
│                                                                              │
