│                                                                              │
│  📁 File: src-tauri/src/pricing/engine.rs                                    │
│                                                                              │
│                                                                              │
│   use super::models::*;                                                      │
│                                                                              │
│   /// Case D1: Tính giá theo giờ (Hourly Pricing)                            │
│   /// Logic từ SkyHotel:                                                     │
│   /// - Giờ đầu tiên: first_hour_price                                       │
│   /// - Mỗi giờ tiếp theo: additional_hour_price                             │
│   /// - Nếu có phần lẻ giờ (> 15 phút): tính thêm surcharge                  │
│   /// - Nếu tổng giờ > max_hours: chuyển sang overnight_price                │
│   pub fn calculate_hourly_price(config: &HourlyPricingConfig, hours: f64)    │
│   -> PricingResult {                                                         │
│       let mut adjustments: Vec<PriceAdjustment> = Vec::new();                │
│                                                                              │
│       // Áp dụng minimum hours                                               │
│       let effective_hours = if hours < config.min_hours as f64 {             │
│           config.min_hours as f64                                            │
│       } else {                                                               │
│           hours                                                              │
│       };                                                                     │
│                                                                              │
│       // Nếu vượt max_hours -> chuyển sang overnight                         │
│       if effective_hours > config.max_hours as f64 {                         │
│           return PricingResult {                                             │
│               final_price: config.overnight_price,                           │
│               base_price: config.overnight_price,                            │
│               adjustments: vec![PriceAdjustment {                            │
│                   label: "Chuyển sang giá qua đêm (vượt giờ tối              │
│   đa)".to_string(),                                                          │
│                   amount: config.overnight_price,                            │
│                   adjustment_type: AdjustmentType::Multiplier,               │
│               }],                                                            │
│               mode: PricingMode::Hourly,                                     │
│           };                                                                 │
│       }                                                                      │
│                                                                              │
│       // Tính giờ tròn và phần lẻ                                            │
│       let full_hours = effective_hours.floor() as u32;                       │
│       let partial_hour = effective_hours - effective_hours.floor();          │
│                                                                              │
│       // Giá giờ đầu tiên                                                    │
│       let mut total = config.first_hour_price;                               │
│       adjustments.push(PriceAdjustment {                                     │
│           label: "Giờ đầu tiên".to_string(),                                 │
│           amount: config.first_hour_price,                                   │
│           adjustment_type: AdjustmentType::Surcharge,                        │
│       });                                                                    │
│                                                                              │
│       // Giá các giờ tiếp theo                                               │
│       if full_hours > 1 {                                                    │
│           let additional = (full_hours - 1) as f64 *                         │
│   config.additional_hour_price;                                              │
│           total += additional;                                               │
│           adjustments.push(PriceAdjustment {                                 │
│               label: format!("{} giờ tiếp theo", full_hours - 1),            │
│               amount: additional,                                            │
│               adjustment_type: AdjustmentType::Surcharge,                    │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // Phụ thu giờ lẻ (nếu phần lẻ > 15 phút = 0.25 giờ)                   │
│       if partial_hour > 0.25 {                                               │
│           let surcharge = config.additional_hour_price *                     │
│   config.partial_hour_surcharge_pct / 100.0;                                 │
│           total += surcharge;                                                │
│           adjustments.push(PriceAdjustment {                                 │
│               label: format!("Phụ thu giờ lẻ ({:.0} phút)", partial_hour *   │
│   60.0),                                                                     │
│               amount: surcharge,                                             │
│               adjustment_type: AdjustmentType::Surcharge,                    │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       let base_price = total;                                                │
│                                                                              │
│       PricingResult {                                                        │
│           final_price: total,                                                │
│           base_price,                                                        │
│           adjustments,                                                       │
│           mode: PricingMode::Hourly,                                         │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// Case D2: Tính giá động (Dynamic Pricing)                               │
│   /// Logic từ SkyHotel:                                                     │
│   /// - Base price * occupancy multiplier                                    │
│   /// - Occupancy > surge_threshold => tăng giá tuyến tính đến               │
│   max_multiplier                                                             │
│   /// - Peak day => nhân thêm peak_day_multiplier                            │
│   /// - Last minute + low occupancy => giảm giá                              │
│   pub fn calculate_dynamic_price(config: &DynamicPricingConfig) ->           │
│   PricingResult {                                                            │
│       let mut adjustments: Vec<PriceAdjustment> = Vec::new();                │
│       let mut total = config.base_price;                                     │
│                                                                              │
│       // Tính occupancy multiplier                                           │
│       let occupancy_multiplier = if config.occupancy_rate >                  │
│   config.surge_threshold {                                                   │
│           // Tuyến tính từ 1.0 đến max_multiplier khi occupancy từ           │
│   surge_threshold đến 1.0                                                    │
│           let surge_range = 1.0 - config.surge_threshold;                    │
│           let surge_progress = (config.occupancy_rate -                      │
│   config.surge_threshold) / surge_range;                                     │
│           1.0 + surge_progress * (config.max_multiplier - 1.0)               │
│       } else {                                                               │
│           1.0                                                                │
│       };                                                                     │
│                                                                              │
│       if occupancy_multiplier > 1.0 {                                        │
│           let surge_amount = config.base_price * (occupancy_multiplier -     │
│   1.0);                                                                      │
│           total += surge_amount;                                             │
│           adjustments.push(PriceAdjustment {                                 │
│               label: format!(                                                │
│                   "Phụ thu cao điểm (occupancy {:.0}%)",                     │
│                   config.occupancy_rate * 100.0                              │
│               ),                                                             │
│               amount: surge_amount,                                          │
│               adjustment_type: AdjustmentType::Surcharge,                    │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // Peak day multiplier                                                 │
│       if config.is_peak_day {                                                │
│           let peak_amount = total * (config.peak_day_multiplier - 1.0);      │
│           total += peak_amount;                                              │
│           adjustments.push(PriceAdjustment {                                 │
│               label: "Phụ thu ngày lễ/cuối tuần".to_string(),                │
│               amount: peak_amount,                                           │
│               adjustment_type: AdjustmentType::Multiplier,                   │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // Last-minute discount (chỉ áp dụng khi occupancy <                   │
│   surge_threshold)                                                           │
│       if config.is_last_minute && config.occupancy_rate <                    │
│   config.surge_threshold {                                                   │
│           let discount = total * config.last_minute_discount_pct / 100.0;    │
│           total -= discount;                                                 │
│           adjustments.push(PriceAdjustment {                                 │
│               label: "Giảm giá last-minute".to_string(),                     │
│               amount: -discount,                                             │
│               adjustment_type: AdjustmentType::Discount,                     │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       PricingResult {                                                        │
│           final_price: total.round(),                                        │
│           base_price: config.base_price,                                     │
│           adjustments,                                                       │
│           mode: PricingMode::Dynamic,                                        │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
