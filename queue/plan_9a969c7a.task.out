│                                                                              │
│  File: mhm/src/components/CheckinSheet.test.tsx                              │
│                                                                              │
│                                                                              │
│   import { describe, test, expect, vi, beforeEach } from "vitest";           │
│   import { render, screen, waitFor } from "@testing-library/react";          │
│   import userEvent from "@testing-library/user-event";                       │
│   import CheckinSheet from "./CheckinSheet";                                 │
│                                                                              │
│   // Mock the Tauri invoke IPC                                               │
│   const mockInvoke = vi.fn();                                                │
│   vi.mock("@tauri-apps/api/core", () => ({                                   │
│     invoke: (...args: unknown[]) => mockInvoke(...args),                     │
│   }));                                                                       │
│                                                                              │
│   // Mock useHotelStore to provide rooms and state                           │
│   vi.mock("../stores/useHotelStore", () => ({                                │
│     useHotelStore: () => ({                                                  │
│       rooms: [                                                               │
│         { id: "101", status: "vacant", type: "standard", base_price:         │
│   350000 },                                                                  │
│         { id: "102", status: "occupied", type: "standard", base_price:       │
│   350000 },                                                                  │
│         { id: "201", status: "vacant", type: "superior", base_price:         │
│   500000 },                                                                  │
│       ],                                                                     │
│       checkIn: vi.fn(),                                                      │
│       fetchRooms: vi.fn(),                                                   │
│       isCheckinOpen: true,                                                   │
│       setCheckinOpen: vi.fn(),                                               │
│     }),                                                                      │
│   }));                                                                       │
│                                                                              │
│   describe("CheckinSheet", () => {                                           │
│     beforeEach(() => {                                                       │
│       mockInvoke.mockReset();                                                │
│       mockInvoke.mockResolvedValue({                                         │
│         line_items: [{ label: "1 đêm × 350.000đ", amount: 350000 }],         │
│         room_subtotal: 350000,                                               │
│         currency: "VND",                                                     │
│       });                                                                    │
│     });                                                                      │
│                                                                              │
│     test("renders title", () => {                                            │
│       render(<CheckinSheet />);                                              │
│       expect(screen.getByText("Check-in Khách Mới")).toBeInTheDocument();    │
│     });                                                                      │
│                                                                              │
│     test("room selector shows vacant rooms", () => {                         │
│       render(<CheckinSheet />);                                              │
│       // Only vacant rooms should appear as selectable options               │
│       expect(screen.getByText("101")).toBeInTheDocument();                   │
│       expect(screen.getByText("201")).toBeInTheDocument();                   │
│       // Occupied room 102 should NOT be shown                               │
│       expect(screen.queryByText("102")).not.toBeInTheDocument();             │
│     });                                                                      │
│                                                                              │
│     test("pricing preview called on room select", async () => {              │
│       const user = userEvent.setup();                                        │
│       render(<CheckinSheet />);                                              │
│                                                                              │
│       // Click on room 101 to select it                                      │
│       const room101 = screen.getByText("101");                               │
│       await user.click(room101);                                             │
│                                                                              │
│       await waitFor(() => {                                                  │
│         expect(mockInvoke).toHaveBeenCalledWith(                             │
│           "pricing_preview",                                                 │
│           expect.objectContaining({                                          │
│             room_id: "101",                                                  │
│           })                                                                 │
│         );                                                                   │
│       });                                                                    │
│     });                                                                      │
│                                                                              │
│     test("quick mode hides CCCD field", () => {                              │
│       render(<CheckinSheet />);                                              │
│       // In quick mode (default), the CCCD/ID card field is not shown        │
│       expect(screen.queryByLabelText("Số CCCD")).not.toBeInTheDocument();    │
│     });                                                                      │
│                                                                              │
│     test("submit disabled without guest name", () => {                       │
│       render(<CheckinSheet />);                                              │
│       const submitButton = screen.getByRole("button", { name: /check-in/i    │
│   });                                                                        │
│       expect(submitButton).toBeDisabled();                                   │
│     });                                                                      │
│   });                                                                        │
