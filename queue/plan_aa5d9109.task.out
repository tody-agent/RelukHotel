│                                                                              │
│                                                                              │
│   // src/features/pricing/components/LateCheckoutMaxWarning.tsx              │
│   import React, { useMemo } from 'react';                                    │
│                                                                              │
│   export type LateCheckoutMaxWarningProps = {                                │
│     actualCheckoutAt?: string | Date | null;                                 │
│     standardCheckoutAt?: string | Date | null;                               │
│     lateCheckoutMaxMinutes?: number | null;                                  │
│     dayPrice?: number | null;                                                │
│     currency?: string;                                                       │
│     className?: string;                                                      │
│   };                                                                         │
│                                                                              │
│   function toDate(value?: string | Date | null): Date | null {               │
│     if (!value) return null;                                                 │
│     const date = value instanceof Date ? value : new Date(value);            │
│     return Number.isNaN(date.getTime()) ? null : date;                       │
│   }                                                                          │
│                                                                              │
│   function formatCurrencyVND(amount: number, currency = 'VND') {             │
│     try {                                                                    │
│       return new Intl.NumberFormat('vi-VN', {                                │
│         style: 'currency',                                                   │
│         currency,                                                            │
│         maximumFractionDigits: 0,                                            │
│       }).format(amount);                                                     │
│     } catch {                                                                │
│       return `${amount.toLocaleString('vi-VN')} ${currency}`;                │
│     }                                                                        │
│   }                                                                          │
│                                                                              │
│   function formatMinutes(minutes: number) {                                  │
│     const hrs = Math.floor(minutes / 60);                                    │
│     const mins = minutes % 60;                                               │
│                                                                              │
│     if (hrs > 0 && mins > 0) return `${hrs} giờ ${mins} phút`;               │
│     if (hrs > 0) return `${hrs} giờ`;                                        │
│     return `${mins} phút`;                                                   │
│   }                                                                          │
│                                                                              │
│   /**                                                                        │
│    * Business flow:                                                          │
│    * - Nếu actualCheckoutAt <= standardCheckoutAt: không warning             │
│    * - Nếu quá giờ check-out nhưng chưa vượt lateCheckoutMaxMinutes: không   │
│   warning ở task này                                                         │
│    * - Nếu số phút trễ > lateCheckoutMaxMinutes: hiển thị warning rằng sẽ    │
│   tính 100% giá ngày                                                         │
│    */                                                                        │
│   export default function LateCheckoutMaxWarning({                           │
│     actualCheckoutAt,                                                        │
│     standardCheckoutAt,                                                      │
│     lateCheckoutMaxMinutes,                                                  │
│     dayPrice,                                                                │
│     currency = 'VND',                                                        │
│     className = '',                                                          │
│   }: LateCheckoutMaxWarningProps) {                                          │
│     const state = useMemo(() => {                                            │
│       const actual = toDate(actualCheckoutAt);                               │
│       const standard = toDate(standardCheckoutAt);                           │
│                                                                              │
│       if (!actual || !standard || lateCheckoutMaxMinutes == null ||          │
│   lateCheckoutMaxMinutes < 0) {                                              │
│         return {                                                             │
│           show: false,                                                       │
│           lateMinutes: 0,                                                    │
│           exceededMinutes: 0,                                                │
│         };                                                                   │
│       }                                                                      │
│                                                                              │
│       const lateMinutes = Math.max(                                          │
│         0,                                                                   │
│         Math.floor((actual.getTime() - standard.getTime()) / 60000),         │
│       );                                                                     │
│                                                                              │
│       const exceededMinutes = lateMinutes - lateCheckoutMaxMinutes;          │
│       const show = lateMinutes > lateCheckoutMaxMinutes;                     │
│                                                                              │
│       return {                                                               │
│         show,                                                                │
│         lateMinutes,                                                         │
│         exceededMinutes: Math.max(0, exceededMinutes),                       │
│       };                                                                     │
│     }, [actualCheckoutAt, standardCheckoutAt, lateCheckoutMaxMinutes]);      │
│                                                                              │
│     if (!state.show) return null;                                            │
│                                                                              │
│     return (                                                                 │
│       <div                                                                   │
│         className={[                                                         │
│           'rounded-xl border border-amber-300 bg-amber-50 px-4 py-3          │
│   text-amber-900',                                                           │
│           className,                                                         │
│         ].join(' ')}                                                         │
│         role="alert"                                                         │
│         aria-live="polite"                                                   │
│       >                                                                      │
│         <div className="flex items-start gap-3">                             │
│           <div className="mt-0.5 text-lg leading-none">⚠️</div>               │
│                                                                              │
│           <div className="min-w-0 flex-1">                                   │
│             <div className="font-semibold">                                  │
│               Late check-out vượt ngưỡng tối đa                              │
│             </div>                                                           │
│                                                                              │
│             <div className="mt-1 text-sm leading-6">                         │
│               Khách đã trả phòng trễ{' '}                                    │
│               <strong>{formatMinutes(state.lateMinutes)}</strong>, vượt      │
│   ngưỡng late                                                                │
│               check-out tối đa                                               │
│   <strong>{formatMinutes(lateCheckoutMaxMinutes!)}</strong>.                 │
│             </div>                                                           │
│                                                                              │
│             <div className="mt-1 text-sm leading-6">                         │
│               Hệ thống sẽ tính <strong>100% giá ngày</strong>                │
│               {typeof dayPrice === 'number'                                  │
│                 ? (                                                          │
│                   <>                                                         │
│                     {' '}= <strong>{formatCurrencyVND(dayPrice,              │
│   currency)}</strong>                                                        │
│                   </>                                                        │
│                 )                                                            │
│                 : null}                                                      │
│               .                                                              │
│             </div>                                                           │
│           </div>                                                             │
│         </div>                                                               │
│       </div>                                                                 │
│     );                                                                       │
│   }                                                                          │
│                                                                              │
