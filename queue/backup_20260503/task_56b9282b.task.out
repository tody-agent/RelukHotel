│           assert_eq!(r.surcharge_amount, 350_000);                           │
│           assert_eq!(r.total, 850_000); // 500k + 150k + 200k                │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn c2_holiday_plus_late_checkout_surcharge_overnight() {               │
