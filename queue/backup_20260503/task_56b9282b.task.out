│               &rule_with_weekend(),                                          │
│               "2026-03-21T10:00:00",                                         │
│               "2026-03-21T12:00:00",                                         │
│               "hourly",                                                      │
│               0.0,                                                           │
│           );                                                                 │
│           // Same-day Saturday: weekend_days = 1, weekend_base =             │
│   daily_rate * 1 = 500k                                                      │
│           // weekend_amount = 20% of 500k = 100k                             │
│           assert!(r.weekend_amount > 0, "Saturday hourly must get weekend    │
│   uplift");                                                                  │
│           assert_eq!(r.weekend_amount, 100_000);                             │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
