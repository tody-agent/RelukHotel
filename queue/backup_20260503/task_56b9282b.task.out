│               "daily",                                                       │
│               10.0,                                                          │
│           );                                                                 │
│           assert_eq!(r.base_amount, 5);                                      │
│           assert_eq!(r.surcharge_amount, 1); // 0.5 → rounds to 1            │
│           assert_eq!(r.total, 6);                                            │
│       }                                                                      │
