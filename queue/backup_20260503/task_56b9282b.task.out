│           PricingRule {                                                      │
│               room_type: "vip".to_string(),                                  │
│               hourly_rate: 200_000,                                          │
│               overnight_rate: 600_000,                                       │
│               daily_rate: 800_000,                                           │
│               weekend_uplift_pct: 50.0,                                      │
│               ..rule_no_weekend()                                            │
│           }                                                                  │
│       }                                                                      │
