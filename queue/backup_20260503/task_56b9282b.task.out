│                                                                              │
│       /// Helper to call calculate_price and unwrap                          │
│       fn calc(                                                               │
│           rule: &PricingRule,                                                │
│           ci: &str,                                                          │
│           co: &str,                                                          │
│           pricing_type: &str,                                                │
│           special_uplift: f64,                                               │
│       ) -> PricingResult {                                                   │
│           calculate_price(rule, ci, co, pricing_type,                        │
│   special_uplift).unwrap()                                                   │
│       }                                                                      │
│                                                                              │
│       /// Standard rule with NO weekend uplift (for C2 isolation)            │
│       fn rule_no_weekend() -> PricingRule {                                  │
│           PricingRule {                                                      │
│               room_type: "deluxe".to_string(),                               │
│               hourly_rate: 100_000,                                          │
│               overnight_rate: 350_000,                                       │
│               daily_rate: 500_000,                                           │
│               overnight_start: "22:00".to_string(),                          │
│               overnight_end: "11:00".to_string(),                            │
│               daily_checkin: "14:00".to_string(),                            │
│               daily_checkout: "12:00".to_string(),                           │
│               early_checkin_surcharge_pct: 30.0,                             │
│               late_checkout_surcharge_pct: 30.0,                             │
│               weekend_uplift_pct: 0.0,                                       │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       /// Standard rule WITH weekend uplift (for C1 tests)                   │
│       fn rule_with_weekend() -> PricingRule {                                │
│           PricingRule {                                                      │
│               weekend_uplift_pct: 20.0,                                      │
│               ..rule_no_weekend()                                            │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       /// VIP rule with higher weekend uplift (stress testing C1)            │
