│       //                                                                     │
│       // Sat 2026-03-28, Sun 2026-03-29                                      │
│                                                                              │
│       // ─── C1.1: Weekday-only stay → zero weekend uplift ───               │
│                                                                              │
│       #[test]                                                                │
│       fn c1_weekday_daily_no_weekend_uplift() {                              │
│           // Tue check-in → Wed check-out (1 day, all weekday)               │
│           let r = calc(                                                      │
│               &rule_with_weekend(),                                          │
│               "2026-03-17T14:00:00",                                         │
│               "2026-03-18T12:00:00",                                         │
│               "daily",                                                       │
│               0.0,                                                           │
│           );                                                                 │
│           assert_eq!(r.weekend_amount, 0, "weekday stay must have zero       │
│   weekend uplift");                                                          │
│           assert_eq!(r.base_amount, 500_000);                                │
│           assert_eq!(r.total, 500_000);                                      │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn c1_weekday_overnight_no_weekend_uplift() {                          │
│           // Wed night → Thu morning (weekday overnight)                     │
│           let r = calc(                                                      │
│               &rule_with_weekend(),                                          │
│               "2026-03-18T22:00:00",                                         │
│               "2026-03-19T11:00:00",                                         │
│               "overnight",                                                   │
│               0.0,                                                           │
│           );                                                                 │
│           assert_eq!(r.weekend_amount, 0);                                   │
│           assert_eq!(r.base_amount, 350_000);                                │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn c1_weekday_hourly_no_weekend_uplift() {                             │
│           // Tuesday 2h stay                                                 │
│           let r = calc(                                                      │
│               &rule_with_weekend(),                                          │
│               "2026-03-17T10:00:00",                                         │
│               "2026-03-17T12:00:00",                                         │
│               "hourly",                                                      │
│               0.0,                                                           │
│           );                                                                 │
│           assert_eq!(r.weekend_amount, 0);                                   │
│           assert_eq!(r.total, 200_000); // 2h x 100k                         │
│       }                                                                      │
│                                                                              │
│       // ─── C1.2: Single Saturday stay → weekend uplift applied ───         │
│                                                                              │
│       #[test]                                                                │
│       fn c1_saturday_daily_has_weekend_uplift() {                            │
│           // Sat check-in → Sun check-out (1 weekend day)                    │
│           let r = calc(                                                      │
│               &rule_with_weekend(),                                          │
│               "2026-03-21T14:00:00",                                         │
│               "2026-03-22T12:00:00",                                         │
│               "daily",                                                       │
│               0.0,                                                           │
│           );                                                                 │
│           // Weekend uplift = 20% of (daily_rate * 1 weekend_day) = 20% of   │
│   500k = 100k                                                                │
│           assert_eq!(r.weekend_amount, 100_000);                             │
│           assert_eq!(r.base_amount, 500_000);                                │
│           assert_eq!(r.total, 600_000);                                      │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn c1_saturday_hourly_has_weekend_uplift() {                           │
