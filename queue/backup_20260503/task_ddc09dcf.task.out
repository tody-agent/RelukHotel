│                                                                              │
│   /// Loại hình thuê phòng                                                   │
│   #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]                 │
│   pub enum BookingType {                                                     │
│       /// A1: Thuê theo giờ                                                  │
│       Hourly,                                                                │
│       /// A2: Thuê qua đêm                                                   │
│       Overnight,                                                             │
│       /// A3: Thuê theo ngày                                                 │
│       Daily,                                                                 │
│   }                                                                          │
│                                                                              │
│   /// Kết quả tính giá                                                       │
│   #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]                 │
│   pub struct PricingResult {                                                 │
│       /// Tổng tiền (VND)                                                    │
│       pub total: u64,                                                        │
│       /// Tiền phòng cơ bản                                                  │
│       pub base_amount: u64,                                                  │
│       /// Phụ thu check-in sớm (A4)                                          │
│       pub early_checkin_surcharge: u64,                                      │
│       /// Phụ thu check-out muộn (A5)                                        │
│       pub late_checkout_surcharge: u64,                                      │
│       /// Loại hình booking được áp dụng                                     │
│       pub booking_type: BookingType,                                         │
│       /// Số giờ / đêm / ngày sử dụng                                        │
│       pub units: u32,                                                        │
│       /// Chi tiết tính toán (human-readable)                                │
│       pub breakdown: String,                                                 │
│   }                                                                          │
│                                                                              │
│   /// A1: Tính giá theo giờ                                                  │
│   /// Logic: first_hour_rate + (số giờ - 1) * hourly_rate                    │
│   /// Tối thiểu min_hours                                                    │
│   pub fn calculate_hourly(                                                   │
│       config: &MotelRoomPrice,                                               │
│       checkin: NaiveDateTime,                                                │
│       checkout: NaiveDateTime,                                               │
│   ) -> PricingResult {                                                       │
│       let duration = checkout.signed_duration_since(checkin);                │
│       let total_minutes = duration.num_minutes().max(0) as u32;              │
│                                                                              │
│       // Làm tròn lên: bất kỳ phút lẻ nào cũng tính thêm 1 giờ               │
│       let mut hours = total_minutes / 60;                                    │
│       if total_minutes % 60 > 0 {                                            │
│           hours += 1;                                                        │
│       }                                                                      │
│                                                                              │
│       // Áp dụng số giờ tối thiểu                                            │
│       hours = hours.max(config.min_hours);                                   │
│                                                                              │
│       // Tính tiền: giờ đầu + các giờ tiếp theo                              │
│       let base_amount = if hours == 0 {                                      │
│           0                                                                  │
│       } else {                                                               │
│           config.first_hour_rate + (hours as u64 - 1) * config.hourly_rate   │
│       };                                                                     │
│                                                                              │
│       PricingResult {                                                        │
│           total: base_amount,                                                │
│           base_amount,                                                       │
│           early_checkin_surcharge: 0,                                        │
│           late_checkout_surcharge: 0,                                        │
│           booking_type: BookingType::Hourly,                                 │
│           units: hours,                                                      │
│           breakdown: format!(                                                │
│               "Giờ đầu: {}đ + {} giờ x {}đ = {}đ (tối thiểu {} giờ)",        │
│               config.first_hour_rate,                                        │
│               hours - 1,                                                     │
│               config.hourly_rate,                                            │
│               base_amount,                                                   │
│               config.min_hours                                               │
│           ),                                                                 │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// A2: Tính giá qua đêm                                                   │
│   /// Logic: overnight_rate nếu checkin >= overnight_start && checkout <=    │
│   overnight_end (hôm sau)                                                    │
│   /// Nếu vượt overnight_end → tính thêm phụ thu giờ                         │
│   pub fn calculate_overnight(                                                │
│       config: &MotelRoomPrice,                                               │
│       checkin: NaiveDateTime,                                                │
│       checkout: NaiveDateTime,                                               │
│   ) -> PricingResult {                                                       │
│       let base_amount = config.overnight_rate;                               │
│                                                                              │
│       // Kiểm tra checkout có vượt quá giờ trả phòng qua đêm không           │
│       let checkout_time = checkout.time();                                   │
│       let mut late_surcharge: u64 = 0;                                       │
│       let mut extra_hours: u32 = 0;                                          │
│                                                                              │
│       if checkout_time > config.overnight_end {                              │
│           let exceed_minutes = time_diff_minutes(config.overnight_end,       │
│   checkout_time);                                                            │
│           // Trừ grace period                                                │
│           let chargeable_minutes =                                           │
│   exceed_minutes.saturating_sub(config.late_checkout_grace_minutes as        │
│   i64);                                                                      │
│           if chargeable_minutes > 0 {                                        │
│               extra_hours = (chargeable_minutes as u32 + 59) / 60; //        │
│   round up                                                                   │
│               late_surcharge = extra_hours as u64 *                          │
│   config.late_checkout_hourly_surcharge;                                     │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       let total = base_amount + late_surcharge;                              │
│                                                                              │
│       PricingResult {                                                        │
│           total,                                                             │
│           base_amount,                                                       │
│           early_checkin_surcharge: 0,                                        │
│           late_checkout_surcharge: late_surcharge,                           │
│           booking_type: BookingType::Overnight,                              │
│           units: 1,                                                          │
│           breakdown: format!(                                                │
│               "Qua đêm: {}đ{}",                                              │
│               base_amount,                                                   │
│               if late_surcharge > 0 {                                        │
│                   format!(" + trả muộn {} giờ x {}đ = {}đ", extra_hours,     │
│   config.late_checkout_hourly_surcharge, late_surcharge)                     │
│               } else {                                                       │
│                   String::new()                                              │
│               }                                                              │
│           ),                                                                 │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// A3: Tính giá theo ngày                                                 │
│   /// Logic: daily_rate * số ngày                                            │
│   pub fn calculate_daily(                                                    │
│       config: &MotelRoomPrice,                                               │
│       checkin: NaiveDateTime,                                                │
│       checkout: NaiveDateTime,                                               │
│   ) -> PricingResult {                                                       │
│       let duration = checkout.signed_duration_since(checkin);                │
│       let total_hours = duration.num_hours().max(0) as u32;                  │
│                                                                              │
│       // Mỗi 24h = 1 ngày, phần lẻ tính thêm 1 ngày                          │
│       let mut days = total_hours / 24;                                       │
│       if total_hours % 24 > 0 {                                              │
│           days += 1;                                                         │
│       }                                                                      │
│       days = days.max(1);                                                    │
│                                                                              │
│       let base_amount = days as u64 * config.daily_rate;                     │
│                                                                              │
│       PricingResult {                                                        │
│           total: base_amount,                                                │
│           base_amount,                                                       │
│           early_checkin_surcharge: 0,                                        │
│           late_checkout_surcharge: 0,                                        │
│           booking_type: BookingType::Daily,                                  │
│           units: days,                                                       │
│           breakdown: format!(                                                │
│               "{} ngày x {}đ = {}đ",                                         │
│               days, config.daily_rate, base_amount                           │
│           ),                                                                 │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// A4: Tính phụ thu check-in sớm                                          │
│   /// Áp dụng khi khách check-in trước giờ standard_checkin (cho booking     │
│   theo ngày)                                                                 │
│   pub fn calculate_early_checkin_surcharge(                                  │
│       config: &MotelRoomPrice,                                               │
│       checkin: NaiveDateTime,                                                │
│   ) -> u64 {                                                                 │
│       let checkin_time = checkin.time();                                     │
│                                                                              │
│       if checkin_time < config.standard_checkin {                            │
│           let diff_minutes = time_diff_minutes(checkin_time,                 │
│   config.standard_checkin);                                                  │
│           let extra_hours = (diff_minutes as u32 + 59) / 60; // round up     │
│           extra_hours as u64 * config.early_checkin_hourly_surcharge         │
│       } else {                                                               │
│           0                                                                  │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// A5: Tính phụ thu check-out muộn                                        │
│   /// Logic theo ngưỡng:                                                     │
│   ///   - Trong grace_minutes: miễn phí                                      │
│   ///   - Trước half_day_threshold: tính theo giờ                            │
│   ///   - half_day_threshold -> full_day_threshold: tính 50% daily_rate      │
│   ///   - Sau full_day_threshold: tính 100% daily_rate (thêm 1 ngày)         │
│   pub fn calculate_late_checkout_surcharge(                                  │
│       config: &MotelRoomPrice,                                               │
│       checkout: NaiveDateTime,                                               │
│   ) -> u64 {                                                                 │
│       let checkout_time = checkout.time();                                   │
│                                                                              │
│       if checkout_time <= config.standard_checkout {                         │
│           return 0;                                                          │
│       }                                                                      │
│                                                                              │
│       // Tính số phút vượt                                                   │
│       let exceed_minutes = time_diff_minutes(config.standard_checkout,       │
│   checkout_time);                                                            │
│                                                                              │
│       // Grace period                                                        │
│       if exceed_minutes <= config.late_checkout_grace_minutes as i64 {       │
│           return 0;                                                          │
│       }                                                                      │
│                                                                              │
│       let checkout_hour = checkout_time.hour();                              │
│                                                                              │
│       // Sau ngưỡng full_day → tính thêm 100% ngày                           │
│       if checkout_hour >= config.late_checkout_full_day_threshold_hour {     │
│           return config.daily_rate;                                          │
│       }                                                                      │
│                                                                              │
│       // Sau ngưỡng half_day → tính 50% ngày                                 │
│       if checkout_hour >= config.late_checkout_half_day_threshold_hour {     │
│           return config.daily_rate / 2;                                      │
│       }                                                                      │
│                                                                              │
│       // Trong khoảng tính theo giờ                                          │
│       let chargeable_minutes = (exceed_minutes -                             │
│   config.late_checkout_grace_minutes as i64).max(0);                         │
│       let extra_hours = (chargeable_minutes as u32 + 59) / 60;               │
│       extra_hours as u64 * config.late_checkout_hourly_surcharge             │
│   }                                                                          │
│                                                                              │
│   /// Tính giá tổng hợp cho booking theo ngày (bao gồm A3 + A4 + A5)         │
│   pub fn calculate_daily_full(                                               │
│       config: &MotelRoomPrice,                                               │
│       checkin: NaiveDateTime,                                                │
│       checkout: NaiveDateTime,                                               │
│   ) -> PricingResult {                                                       │
│       let mut result = calculate_daily(config, checkin, checkout);           │
│                                                                              │
│       let early_surcharge = calculate_early_checkin_surcharge(config,        │
│   checkin);                                                                  │
│       let late_surcharge = calculate_late_checkout_surcharge(config,         │
│   checkout);                                                                 │
│                                                                              │
│       result.early_checkin_surcharge = early_surcharge;                      │
│       result.late_checkout_surcharge = late_surcharge;                       │
│       result.total = result.base_amount + early_surcharge +                  │
│   late_surcharge;                                                            │
│       result.breakdown = format!(                                            │
│           "{} | Check-in sớm: {}đ | Check-out muộn: {}đ | Tổng: {}đ",        │
│           result.breakdown, early_surcharge, late_surcharge, result.total    │
│       );                                                                     │
│                                                                              │
│       result                                                                 │
│   }                                                                          │
│                                                                              │
│   /// Helper: tính chênh lệch phút giữa 2 thời điểm trong ngày               │
│   fn time_diff_minutes(from: NaiveTime, to: NaiveTime) -> i64 {              │
│       let from_secs = from.num_seconds_from_midnight() as i64;               │
│       let to_secs = to.num_seconds_from_midnight() as i64;                   │
│       (to_secs - from_secs) / 60                                             │
│   }                                                                          │
│                                                                              │
│                                                                              │
