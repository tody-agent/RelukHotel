│       /// Giờ bắt đầu tính qua đêm (e.g., 22:00)                             │
│       pub overnight_start: NaiveTime,                                        │
│       /// Giờ kết thúc qua đêm (e.g., 11:00 hôm sau)                         │
│       pub overnight_end: NaiveTime,                                          │
│       /// Giá theo ngày (VND)                                                │
│       pub daily_rate: u64,                                                   │
│       /// Giờ check-in tiêu chuẩn (e.g., 14:00)                              │
│       pub standard_checkin: NaiveTime,                                       │
│       /// Giờ check-out tiêu chuẩn (e.g., 12:00)                             │
│       pub standard_checkout: NaiveTime,                                      │
│       /// Phụ thu check-in sớm mỗi giờ (VND)                                 │
│       pub early_checkin_hourly_surcharge: u64,                               │
│       /// Phụ thu check-out muộn mỗi giờ (VND)                               │
