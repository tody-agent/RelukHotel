│                                                                              │
│           let surcharge = calculate_late_checkout_surcharge(&config,         │
│   checkout);                                                                 │
│           assert_eq!(surcharge, 350_000);                                    │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn a5_10_full_calculation_with_daily() {                               │
│           // Test tổng hợp: 1 ngày + checkout muộn (half day)                │
│           let config = default_config();                                     │
│           let checkin = dt(2025, 1, 15, 14, 0);                              │
│           let checkout = dt(2025, 1, 16, 16, 0); // muộn, hour=16 >= 15      │
│                                                                              │
│           let result = calculate_daily_full(&config, checkin, checkout);     │
│                                                                              │
│           // base: ceil(26h/24) = 2 ngày = 700k                              │
│           // late surcharge: 50% * 350k = 175k                               │
│           // Nhưng ở đây cần xem xét: checkout 16:00 so với checkin 14:00    │
│   = 26h → 2 ngày                                                             │
│           // late checkout surcharge tính riêng dựa trên checkout_time vs    │
│   standard_checkout                                                          │
│           assert_eq!(result.late_checkout_surcharge, 175_000);               │
│           assert_eq!(result.early_checkin_surcharge, 0);                     │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn a5_11_combined_early_and_late() {                                   │
│           // Check-in 10:00 (sớm 4 giờ) + check-out 17:00 (muộn half-day)    │
│           let config = default_config();                                     │
│           let checkin = dt(2025, 1, 15, 10, 0);                              │
│           let checkout = dt(2025, 1, 16, 17, 0);                             │
│                                                                              │
│           let result = calculate_daily_full(&config, checkin, checkout);     │
│                                                                              │
│           // base: ceil(31h/24) = 2 ngày = 700k                              │
│           // early: 4h * 30k = 120k                                          │
│           // late: 50% * 350k = 175k                                         │
│           assert_eq!(result.early_checkin_surcharge, 120_000);               │
│           assert_eq!(result.late_checkout_surcharge, 175_000);               │
│           assert_eq!(result.total, 700_000 + 120_000 + 175_000);             │
│       }                                                                      │
│   }                                                                          │
