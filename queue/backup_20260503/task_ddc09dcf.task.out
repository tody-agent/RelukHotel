│                                                                              │
│   /// Helper: tạo NaiveDateTime nhanh                                        │
│   fn dt(year: i32, month: u32, day: u32, hour: u32, min: u32) ->             │
│   NaiveDateTime {                                                            │
│       NaiveDate::from_ymd_opt(year, month, day)                              │
│           .unwrap()                                                          │
│           .and_hms_opt(hour, min, 0)                                         │
│           .unwrap()                                                          │
│   }                                                                          │
│                                                                              │
