│   // ═══════════════════════════════════════════════════════════════════     │
│   // A1: TÍNH GIÁ THEO GIỜ (HOURLY PRICING)                                  │
│   // ═══════════════════════════════════════════════════════════════════     │
│                                                                              │
│   #[cfg(test)]                                                               │
│   mod a1_hourly_pricing {                                                    │
│       use super::*;                                                          │
│                                                                              │
│       #[test]                                                                │
│       fn a1_01_exact_2_hours_minimum() {                                     │
│           // Thuê đúng 2 giờ (= min_hours)                                   │
│           let config = default_config();                                     │
│           let checkin = dt(2025, 1, 15, 8, 0);                               │
│           let checkout = dt(2025, 1, 15, 10, 0);                             │
│                                                                              │
│           let result = calculate_hourly(&config, checkin, checkout);         │
│                                                                              │
│           // first_hour_rate(70k) + 1 * hourly_rate(50k) = 120k              │
│           assert_eq!(result.total, 120_000);                                 │
│           assert_eq!(result.units, 2);                                       │
│           assert_eq!(result.booking_type, BookingType::Hourly);              │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn a1_02_less_than_min_hours_rounds_up() {                             │
│           // Thuê 1 giờ nhưng min_hours = 2 → tính 2 giờ                     │
│           let config = default_config();                                     │
│           let checkin = dt(2025, 1, 15, 8, 0);                               │
│           let checkout = dt(2025, 1, 15, 9, 0);                              │
│                                                                              │
│           let result = calculate_hourly(&config, checkin, checkout);         │
│                                                                              │
│           assert_eq!(result.total, 120_000); // vẫn tính 2 giờ tối thiểu     │
│           assert_eq!(result.units, 2);                                       │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn a1_03_partial_hour_rounds_up() {                                    │
│           // Thuê 2 giờ 15 phút → tính 3 giờ                                 │
│           let config = default_config();                                     │
