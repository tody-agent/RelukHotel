│       pub late_checkout_grace_minutes: u32,                                  │
│       /// Ngưỡng giờ check-out muộn tính thêm 50% ngày                       │
│       pub late_checkout_half_day_threshold_hour: u32,                        │
│       /// Ngưỡng giờ check-out muộn tính thêm 100% ngày                      │
│       pub late_checkout_full_day_threshold_hour: u32,                        │
│   }                                                                          │
