│           let checkout = dt(2025, 1, 16, 8, 0);                              │
│                                                                              │
│           let overnight = calculate_overnight(&config, checkin, checkout);   │
│           let daily = calculate_daily(&config, checkin, checkout);           │
│                                                                              │
