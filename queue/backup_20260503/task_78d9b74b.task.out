│  FILE 3: mhm/src-tauri/src/domain/pricing_engine_v2.rs — Rust domain logic   │
│                                                                              │
│                                                                              │
│   //! Pricing Engine V2: Dynamic price calculation with rate plans and       │
│   rules.                                                                     │
│   //!                                                                        │
│   //! Replaces the flat `pricing_rules` approach with layered rate plans     │
│   //! inspired by SkyHotel's Vietnamese hotel pricing model.                 │
│                                                                              │
│   use chrono::{Datelike, NaiveDate, Weekday};                                │
│   use serde::{Deserialize, Serialize};                                       │
│                                                                              │
│   use crate::money::{validate_transport_money_vnd, MoneyVnd};                │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Domain Models                                                           │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct RatePlan {                                                      │
│       pub id: String,                                                        │
│       pub name: String,                                                      │
│       pub description: Option<String>,                                       │
│       pub effective_from: String,                                            │
│       pub effective_to: Option<String>,                                      │
│       pub priority: i32,                                                     │
│       pub is_active: bool,                                                   │
│       pub base_rate_override: Option<MoneyVnd>,                              │
│       pub created_by: Option<String>,                                        │
│       pub created_at: String,                                                │
│       pub updated_at: String,                                                │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]             │
│   #[serde(rename_all = "snake_case")]                                        │
│   pub enum DynamicRuleType {                                                 │
│       DayOfWeek,                                                             │
│       Occupancy,                                                             │
│       LeadTime,                                                              │
│       LengthOfStay,                                                          │
│       DateRange,                                                             │
│       GuestCount,                                                            │
│   }                                                                          │
│                                                                              │
│   impl DynamicRuleType {                                                     │
│       pub fn as_str(&self) -> &'static str {                                 │
│           match self {                                                       │
│               Self::DayOfWeek => "day_of_week",                              │
│               Self::Occupancy => "occupancy",                                │
│               Self::LeadTime => "lead_time",                                 │
│               Self::LengthOfStay => "length_of_stay",                        │
│               Self::DateRange => "date_range",                               │
│               Self::GuestCount => "guest_count",                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       pub fn from_str(s: &str) -> Option<Self> {                             │
│           match s {                                                          │
│               "day_of_week" => Some(Self::DayOfWeek),                        │
│               "occupancy" => Some(Self::Occupancy),                          │
│               "lead_time" => Some(Self::LeadTime),                           │
│               "length_of_stay" => Some(Self::LengthOfStay),                  │
│               "date_range" => Some(Self::DateRange),                         │
│               "guest_count" => Some(Self::GuestCount),                       │
│               _ => None,                                                     │
│           }                                                                  │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct DynamicPriceRule {                                              │
│       pub id: String,                                                        │
│       pub rate_plan_id: String,                                              │
│       pub name: String,                                                      │
│       pub rule_type: String,                                                 │
│       pub condition_json: String,                                            │
│       pub priority: i32,                                                     │
│       pub is_stackable: bool,                                                │
│       pub is_active: bool,                                                   │
│       pub created_at: String,                                                │
│       pub updated_at: String,                                                │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]             │
│   #[serde(rename_all = "snake_case")]                                        │
│   pub enum AdjustmentType {                                                  │
│       Fixed,                                                                 │
│       Percent,                                                               │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct DynamicPriceRuleValue {                                         │
│       pub id: String,                                                        │
│       pub rule_id: String,                                                   │
│       pub room_type: Option<String>,                                         │
│       pub adjustment_type: String,                                           │
│       pub adjustment_value: MoneyVnd,                                        │
│       pub min_price: Option<MoneyVnd>,                                       │
│       pub max_price: Option<MoneyVnd>,                                       │
│       pub created_at: String,                                                │
│       pub updated_at: String,                                                │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Rule Condition Models (parsed from condition_json)                      │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct DayOfWeekCondition {                                            │
│       /// 0=Monday, 6=Sunday (ISO weekday)                                   │
│       pub days: Vec<u8>,                                                     │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct OccupancyCondition {                                            │
│       /// Minimum occupancy percentage to trigger                            │
│       pub min_pct: f64,                                                      │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct LeadTimeCondition {                                             │
│       /// Maximum days in advance (booking made <= N days before check-in)   │
│       pub max_days: i32,                                                     │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct LengthOfStayCondition {                                         │
│       /// Minimum nights for this rule to apply                              │
│       pub min_nights: i32,                                                   │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct DateRangeCondition {                                            │
│       /// ISO date "YYYY-MM-DD"                                              │
│       pub from: String,                                                      │
│       /// ISO date "YYYY-MM-DD"                                              │
│       pub to: String,                                                        │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct GuestCountCondition {                                           │
│       /// Minimum number of guests in room                                   │
│       pub min_guests: i32,                                                   │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Pricing Context (inputs for calculation)                                │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   #[derive(Debug, Clone)]                                                    │
│   pub struct PricingContext {                                                │
│       pub room_type: String,                                                 │
│       pub base_price: MoneyVnd,                                              │
│       pub check_in_date: NaiveDate,                                          │
│       pub check_out_date: NaiveDate,                                         │
│       pub booking_created_date: NaiveDate,                                   │
│       pub guest_count: i32,                                                  │
│       pub current_occupancy_pct: f64,                                        │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Applied Rule Snapshot (stored on booking)                               │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct AppliedRuleSnapshot {                                           │
│       pub rule_id: String,                                                   │
│       pub rule_name: String,                                                 │
│       pub rule_type: String,                                                 │
│       pub adjustment_type: String,                                           │
│       pub adjustment_value: MoneyVnd,                                        │
│       pub computed_amount: MoneyVnd,                                         │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Pricing Engine V2 — Core Calculation                                    │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct PricingEngineV2Result {                                         │
│       pub rate_plan_id: String,                                              │
│       pub rate_plan_name: String,                                            │
│       pub base_price_per_night: MoneyVnd,                                    │
│       pub nights: i32,                                                       │
│       pub base_total: MoneyVnd,                                              │
│       pub adjustment_total: MoneyVnd,                                        │
│       pub final_total: MoneyVnd,                                             │
│       pub applied_rules: Vec<AppliedRuleSnapshot>,                           │
│       pub nightly_breakdown: Vec<NightlyPrice>,                              │
│   }                                                                          │
│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct NightlyPrice {                                                  │
│       pub date: String,                                                      │
│       pub base_price: MoneyVnd,                                              │
│       pub adjusted_price: MoneyVnd,                                          │
│       pub rules_applied: Vec<String>,                                        │
│   }                                                                          │
│                                                                              │
│   /// Main entry point: calculate dynamic price for a stay                   │
│   pub fn calculate_dynamic_price(                                            │
│       ctx: &PricingContext,                                                  │
│       rate_plan: &RatePlan,                                                  │
│       rules: &[DynamicPriceRule],                                            │
│       values: &[DynamicPriceRuleValue],                                      │
│   ) -> Result<PricingEngineV2Result, String> {                               │
│       let nights = (ctx.check_out_date - ctx.check_in_date).num_days() as    │
│   i32;                                                                       │
│       if nights <= 0 {                                                       │
│           return Err("Check-out must be after check-in".to_string());        │
│       }                                                                      │
│                                                                              │
│       let base_per_night =                                                   │
│   rate_plan.base_rate_override.unwrap_or(ctx.base_price);                    │
│       let mut nightly_breakdown: Vec<NightlyPrice> =                         │
│   Vec::with_capacity(nights as usize);                                       │
│       let mut all_applied_rules: Vec<AppliedRuleSnapshot> = Vec::new();      │
│       let mut total_adjustment: MoneyVnd = 0;                                │
│                                                                              │
│       // Calculate price per night                                           │
│       for night_idx in 0..nights {                                           │
│           let stay_date = ctx                                                │
│               .check_in_date                                                 │
│               .checked_add_signed(chrono::Duration::days(night_idx as        │
│   i64))                                                                      │
│               .ok_or_else(|| "Date overflow".to_string())?;                  │
│                                                                              │
│           let mut night_price = base_per_night;                              │
│           let mut night_rules: Vec<String> = Vec::new();                     │
│           let mut non_stackable_applied = false;                             │
│                                                                              │
│           // Evaluate rules sorted by priority (highest first)               │
│           let mut sorted_rules: Vec<&DynamicPriceRule> =                     │
│               rules.iter().filter(|r| r.is_active).collect();                │
│           sorted_rules.sort_by(|a, b| b.priority.cmp(&a.priority));          │
│                                                                              │
│           for rule in &sorted_rules {                                        │
│               // Skip if non-stackable rule already applied                  │
│               if non_stackable_applied && !rule.is_stackable {               │
│                   continue;                                                  │
│               }                                                              │
│                                                                              │
│               // Evaluate condition                                          │
│               if !evaluate_rule_condition(rule, &stay_date, ctx, nights)?    │
│   {                                                                          │
│                   continue;                                                  │
│               }                                                              │
│                                                                              │
│               // Find matching value (room_type specific > default NULL)     │
│               let value = find_matching_value(values, &rule.id,              │
│   &ctx.room_type);                                                           │
│               let Some(value) = value else { continue };                     │
│                                                                              │
│               // Calculate adjustment                                        │
│               let adjustment = calculate_adjustment(base_per_night,          │
│   value)?;                                                                   │
│                                                                              │
│               night_price = apply_adjustment_with_caps(night_price,          │
│   adjustment, value)?;                                                       │
│               night_rules.push(rule.name.clone());                           │
│                                                                              │
│               // Record applied rule (only once per rule across all nights   │
│   for snapshot)                                                              │
│               if !all_applied_rules.iter().any(|r| r.rule_id == rule.id) {   │
│                   all_applied_rules.push(AppliedRuleSnapshot {               │
│                       rule_id: rule.id.clone(),                              │
│                       rule_name: rule.name.clone(),                          │
│                       rule_type: rule.rule_type.clone(),                     │
│                       adjustment_type: value.adjustment_type.clone(),        │
│                       adjustment_value: value.adjustment_value,              │
│                       computed_amount: adjustment,                           │
│                   });                                                        │
│               }                                                              │
│                                                                              │
│               total_adjustment = total_adjustment                            │
│                   .checked_add(adjustment)                                   │
│                   .ok_or_else(|| "Adjustment overflow".to_string())?;        │
│                                                                              │
│               if !rule.is_stackable {                                        │
│                   non_stackable_applied = true;                              │
│               }                                                              │
│           }                                                                  │
│                                                                              │
│           nightly_breakdown.push(NightlyPrice {                              │
│               date: stay_date.format("%Y-%m-%d").to_string(),                │
│               base_price: base_per_night,                                    │
│               adjusted_price: night_price,                                   │
│               rules_applied: night_rules,                                    │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       let base_total = base_per_night                                        │
│           .checked_mul(nights as i64)                                        │
│           .ok_or_else(|| "Base total overflow".to_string())?;                │
│                                                                              │
│       let final_total: MoneyVnd = nightly_breakdown                          │
│           .iter()                                                            │
│           .try_fold(0i64, |acc, n| acc.checked_add(n.adjusted_price))        │
│           .ok_or_else(|| "Final total overflow".to_string())?;               │
│                                                                              │
│       validate_transport_money_vnd(final_total, "final_total").map_err(|e|   │
│   e.message)?;                                                               │
│                                                                              │
│       Ok(PricingEngineV2Result {                                             │
│           rate_plan_id: rate_plan.id.clone(),                                │
│           rate_plan_name: rate_plan.name.clone(),                            │
│           base_price_per_night: base_per_night,                              │
│           nights,                                                            │
│           base_total,                                                        │
│           adjustment_total: final_total - base_total,                        │
│           final_total,                                                       │
│           applied_rules: all_applied_rules,                                  │
│           nightly_breakdown,                                                 │
│       })                                                                     │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Rule Evaluation                                                         │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   fn evaluate_rule_condition(                                                │
│       rule: &DynamicPriceRule,                                               │
│       stay_date: &NaiveDate,                                                 │
│       ctx: &PricingContext,                                                  │
│       total_nights: i32,                                                     │
│   ) -> Result<bool, String> {                                                │
│       let rule_type = DynamicRuleType::from_str(&rule.rule_type)             │
│           .ok_or_else(|| format!("Unknown rule_type: {}",                    │
│   rule.rule_type))?;                                                         │
│                                                                              │
│       match rule_type {                                                      │
│           DynamicRuleType::DayOfWeek => {                                    │
│               let cond: DayOfWeekCondition =                                 │
│   serde_json::from_str(&rule.condition_json)                                 │
│                   .map_err(|e| format!("Invalid day_of_week condition:       │
│   {e}"))?;                                                                   │
│               let weekday_num = match stay_date.weekday() {                  │
│                   Weekday::Mon => 0,                                         │
│                   Weekday::Tue => 1,                                         │
│                   Weekday::Wed => 2,                                         │
│                   Weekday::Thu => 3,                                         │
│                   Weekday::Fri => 4,                                         │
│                   Weekday::Sat => 5,                                         │
│                   Weekday::Sun => 6,                                         │
│               };                                                             │
│               Ok(cond.days.contains(&weekday_num))                           │
│           }                                                                  │
│           DynamicRuleType::Occupancy => {                                    │
│               let cond: OccupancyCondition =                                 │
│   serde_json::from_str(&rule.condition_json)                                 │
│                   .map_err(|e| format!("Invalid occupancy condition:         │
│   {e}"))?;                                                                   │
│               Ok(ctx.current_occupancy_pct >= cond.min_pct)                  │
│           }                                                                  │
│           DynamicRuleType::LeadTime => {                                     │
│               let cond: LeadTimeCondition =                                  │
│   serde_json::from_str(&rule.condition_json)                                 │
│                   .map_err(|e| format!("Invalid lead_time condition:         │
│   {e}"))?;                                                                   │
│               let lead_days = (ctx.check_in_date -                           │
│   ctx.booking_created_date).num_days() as i32;                               │
│               Ok(lead_days <= cond.max_days)                                 │
│           }                                                                  │
│           DynamicRuleType::LengthOfStay => {                                 │
│               let cond: LengthOfStayCondition =                              │
│   serde_json::from_str(&rule.condition_json)                                 │
│                   .map_err(|e| format!("Invalid length_of_stay condition:    │
│   {e}"))?;                                                                   │
│               Ok(total_nights >= cond.min_nights)                            │
│           }                                                                  │
│           DynamicRuleType::DateRange => {                                    │
│               let cond: DateRangeCondition =                                 │
│   serde_json::from_str(&rule.condition_json)                                 │
│                   .map_err(|e| format!("Invalid date_range condition:        │
│   {e}"))?;                                                                   │
│               let from = NaiveDate::parse_from_str(&cond.from, "%Y-%m-%d")   │
│                   .map_err(|e| format!("Invalid date_range from: {e}"))?;    │
│               let to = NaiveDate::parse_from_str(&cond.to, "%Y-%m-%d")       │
│                   .map_err(|e| format!("Invalid date_range to: {e}"))?;      │
│               Ok(*stay_date >= from && *stay_date <= to)                     │
│           }                                                                  │
│           DynamicRuleType::GuestCount => {                                   │
│               let cond: GuestCountCondition =                                │
│   serde_json::from_str(&rule.condition_json)                                 │
│                   .map_err(|e| format!("Invalid guest_count condition:       │
│   {e}"))?;                                                                   │
│               Ok(ctx.guest_count >= cond.min_guests)                         │
│           }                                                                  │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   fn find_matching_value<'a>(                                                │
│       values: &'a [DynamicPriceRuleValue],                                   │
│       rule_id: &str,                                                         │
│       room_type: &str,                                                       │
│   ) -> Option<&'a DynamicPriceRuleValue> {                                   │
│       // First: exact room_type match                                        │
│       let specific = values                                                  │
│           .iter()                                                            │
│           .find(|v| v.rule_id == rule_id && v.room_type.as_deref() ==        │
│   Some(room_type));                                                          │
│                                                                              │
│       if specific.is_some() {                                                │
│           return specific;                                                   │
│       }                                                                      │
│                                                                              │
│       // Fallback: default (room_type = NULL)                                │
│       values                                                                 │
│           .iter()                                                            │
│           .find(|v| v.rule_id == rule_id && v.room_type.is_none())           │
│   }                                                                          │
│                                                                              │
│   fn calculate_adjustment(                                                   │
│       base_price: MoneyVnd,                                                  │
│       value: &DynamicPriceRuleValue,                                         │
│   ) -> Result<MoneyVnd, String> {                                            │
│       match value.adjustment_type.as_str() {                                 │
│           "fixed" => Ok(value.adjustment_value),                             │
│           "percent" => {                                                     │
│               // adjustment_value is percentage * 100 basis points or just   │
│   whole percent                                                              │
│               // e.g. 20 means +20%                                          │
│               let pct = value.adjustment_value as f64 / 100.0;               │
│               let raw = (base_price as f64 * pct).round() as MoneyVnd;       │
│               Ok(raw)                                                        │
│           }                                                                  │
│           other => Err(format!("Unknown adjustment_type: {other}")),         │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   fn apply_adjustment_with_caps(                                             │
│       current_price: MoneyVnd,                                               │
│       adjustment: MoneyVnd,                                                  │
│       value: &DynamicPriceRuleValue,                                         │
│   ) -> Result<MoneyVnd, String> {                                            │
│       let mut new_price = current_price                                      │
│           .checked_add(adjustment)                                           │
│           .ok_or_else(|| "Price adjustment overflow".to_string())?;          │
│                                                                              │
│       // Apply min cap                                                       │
│       if let Some(min) = value.min_price {                                   │
│           if new_price < min {                                               │
│               new_price = min;                                               │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       // Apply max cap                                                       │
│       if let Some(max) = value.max_price {                                   │
│           if new_price > max {                                               │
│               new_price = max;                                               │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       // Never go below 0                                                    │
│       if new_price < 0 {                                                     │
│           new_price = 0;                                                     │
│       }                                                                      │
│                                                                              │
│       Ok(new_price)                                                          │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Utility: Find applicable rate plan for a date                           │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   /// Given a list of active rate plans, find the best one for the given     │
│   date.                                                                      │
│   /// Returns the highest-priority plan whose effective range includes the   │
│   date.                                                                      │
│   pub fn find_applicable_rate_plan(plans: &[RatePlan], date: &NaiveDate)     │
│   -> Option<&RatePlan> {                                                     │
│       let date_str = date.format("%Y-%m-%d").to_string();                    │
│                                                                              │
│       let mut applicable: Vec<&RatePlan> = plans                             │
│           .iter()                                                            │
│           .filter(|p| p.is_active)                                           │
│           .filter(|p| p.effective_from <= date_str)                          │
│           .filter(|p| match &p.effective_to {                                │
│               Some(to) => *to >= date_str,                                   │
│               None => true, // no end = always valid                         │
│           })                                                                 │
│           .collect();                                                        │
│                                                                              │
│       applicable.sort_by(|a, b| b.priority.cmp(&a.priority));                │
│       applicable.first().copied()                                            │
│   }                                                                          │
│                                                                              │
│   // ═══════════════════════════════════════════════                         │
│   // Unit Tests                                                              │
│   // ═══════════════════════════════════════════════                         │
│                                                                              │
│   #[cfg(test)]                                                               │
│   mod tests {                                                                │
│       use super::*;                                                          │
│                                                                              │
│       fn make_ctx() -> PricingContext {                                      │
│           PricingContext {                                                   │
│               room_type: "deluxe".to_string(),                               │
│               base_price: 500_000,                                           │
│               check_in_date: NaiveDate::from_ymd_opt(2026, 5, 1).unwrap(),   │
│               check_out_date: NaiveDate::from_ymd_opt(2026, 5,               │
│   4).unwrap(), // 3 nights                                                   │
│               booking_created_date: NaiveDate::from_ymd_opt(2026, 4,         │
│   30).unwrap(), // 1 day lead                                                │
│               guest_count: 2,                                                │
│               current_occupancy_pct: 70.0,                                   │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       fn make_rate_plan() -> RatePlan {                                      │
│           RatePlan {                                                         │
│               id: "rp-001".to_string(),                                      │
│               name: "Standard 2026".to_string(),                             │
│               description: None,                                             │
│               effective_from: "2026-01-01".to_string(),                      │
│               effective_to: Some("2026-12-31".to_string()),                  │
│               priority: 10,                                                  │
│               is_active: true,                                               │
│               base_rate_override: None,                                      │
│               created_by: None,                                              │
│               created_at: "2026-01-01T00:00:00".to_string(),                 │
│               updated_at: "2026-01-01T00:00:00".to_string(),                 │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn test_no_rules_returns_base_price() {                                │
│           let ctx = make_ctx();                                              │
│           let plan = make_rate_plan();                                       │
│           let result = calculate_dynamic_price(&ctx, &plan, &[],             │
│   &[]).unwrap();                                                             │
│                                                                              │
│           assert_eq!(result.nights, 3);                                      │
│           assert_eq!(result.base_total, 1_500_000);                          │
│           assert_eq!(result.final_total, 1_500_000);                         │
│           assert_eq!(result.adjustment_total, 0);                            │
│           assert!(result.applied_rules.is_empty());                          │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn test_weekend_surcharge_rule() {                                     │
│           let ctx = PricingContext {                                         │
│               // Fri May 1 -> Mon May 4: Sat(2) and Sun(3) are weekends      │
│               check_in_date: NaiveDate::from_ymd_opt(2026, 5, 1).unwrap(),   │
│   // Friday                                                                  │
│               check_out_date: NaiveDate::from_ymd_opt(2026, 5,               │
│   4).unwrap(), // Monday                                                     │
│               ..make_ctx()                                                   │
│           };                                                                 │
│           let plan = make_rate_plan();                                       │
│                                                                              │
│           let rules = vec![DynamicPriceRule {                                │
│               id: "rule-wknd".to_string(),                                   │
│               rate_plan_id: "rp-001".to_string(),                            │
│               name: "Weekend +20%".to_string(),                              │
│               rule_type: "day_of_week".to_string(),                          │
│               condition_json: r#"{"days": [5, 6]}"#.to_string(), // Sat,     │
│   Sun                                                                        │
│               priority: 10,                                                  │
│               is_stackable: true,                                            │
│               is_active: true,                                               │
│               created_at: "2026-01-01T00:00:00".to_string(),                 │
│               updated_at: "2026-01-01T00:00:00".to_string(),                 │
│           }];                                                                │
│                                                                              │
│           let values = vec![DynamicPriceRuleValue {                          │
│               id: "val-001".to_string(),                                     │
