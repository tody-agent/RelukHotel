│   Decimal::from(input.occupancy.nights);                                     │
│                                                                              │
│           let extra_bed_amount = if input.extra_bed_policy.enabled {         │
│               match input.extra_bed_policy.charge_mode {                     │
│                   ExtraBedChargeMode::PerBedPerNight => {                    │
│                       input.extra_bed_policy.price_per_bed_per_night         │
│                           * Decimal::from(input.occupancy.extra_beds)        │
│                           * Decimal::from(input.occupancy.nights)            │
│                   }                                                          │
│               }                                                              │
│           } else {                                                           │
│               dec!(0)                                                        │
│           };                                                                 │
│                                                                              │
│           let subtotal = room_amount + extra_bed_amount;                     │
│                                                                              │
│           let mut lines = vec![PriceLine {                                   │
│               code: "ROOM".to_string(),                                      │
│               description: "Room charge".to_string(),                        │
│               unit_price: input.room_rate_per_night,                         │
│               quantity: Decimal::from(input.occupancy.nights),               │
│               amount: room_amount,                                           │
│           }];                                                                │
│                                                                              │
│           if extra_bed_amount > dec!(0) {                                    │
│               lines.push(PriceLine {                                         │
│                   code: "EXTRA_BED".to_string(),                             │
│                   description: "Extra bed charge".to_string(),               │
│                   unit_price:                                                │
│   input.extra_bed_policy.price_per_bed_per_night,                            │
│                   quantity: Decimal::from(input.occupancy.extra_beds *       │
│   input.occupancy.nights),                                                   │
│                   amount: extra_bed_amount,                                  │
│               });                                                            │
│           }                                                                  │
