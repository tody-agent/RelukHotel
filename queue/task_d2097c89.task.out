│   ═══════════════════════════════════════════════════════════════════════    │
│       // CASE G2: Monthly rate, 2 guests, standard room                      │
│       // Expected: total = base_monthly_rate + (extra_guest_surcharge *      │
│   days_in_month)                                                             │
│       //                                                                     │
│   ═══════════════════════════════════════════════════════════════════════    │
│       #[test]                                                                │
│       fn test_g2_monthly_two_guests_standard_room() {                        │
│           // Arrange                                                         │
│           let input = make_monthly_input(                                    │
│               2,              // guest_count                                 │
│               dec!(6000000),  // base_monthly_rate: 6,000,000 VND            │
│               dec!(100000),   // extra_guest_surcharge_per_day: 100,000      │
│   VND                                                                        │
│               30,             // days_in_month                               │
│               false,          // no early check-in                           │
│               false,          // no late checkout                            │
│               dec!(0),                                                       │
│               dec!(0),                                                       │
│           );                                                                 │
│                                                                              │
│           // Act                                                             │
│           let result = PricingEngine::calculate(&input);                     │
│                                                                              │
│           // Assert                                                          │
│           assert!(result.is_ok());                                           │
│           let pricing: PricingResult = result.unwrap();                      │
│                                                                              │
│           // extra_guest_charge = 100,000 * 30 = 3,000,000 VND               │
│           let expected_extra = dec!(100000) * dec!(30);                      │
│           let expected_total = dec!(6000000) + expected_extra;               │
│                                                                              │
│           assert_eq!(pricing.room_charge, dec!(6000000));                    │
│           assert_eq!(pricing.extra_guest_charge, expected_extra);            │
│           assert_eq!(pricing.extra_guest_charge, dec!(3000000));             │
│           assert_eq!(pricing.subtotal, expected_total);                      │
│           assert_eq!(pricing.total, dec!(9000000));                          │
│           assert_eq!(pricing.booking_type, BookingType::Monthly);            │
│       }                                                                      │
