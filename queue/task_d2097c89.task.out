│           let pricing = result.unwrap();                                     │
│           // 2 extra guests * 100,000 * 30 = 6,000,000                       │
│           let expected_extra = dec!(100000) * dec!(2) * dec!(30);            │
│           assert_eq!(pricing.extra_guest_charge, expected_extra);            │
