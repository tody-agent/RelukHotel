│                                                                              │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct PricingResult {                                                 │
│       pub booking_type: BookingType,                                         │
│       pub room_charge: Decimal,                                              │
│       pub extra_guest_charge: Decimal,                                       │
│       pub early_checkin_charge: Decimal,                                     │
│       pub late_checkout_charge: Decimal,                                     │
│       pub extra_charges_total: Decimal,                                      │
│       pub subtotal: Decimal,                                                 │
│       pub discount_amount: Decimal,                                          │
│       pub vat_amount: Decimal,                                               │
│       pub total: Decimal,                                                    │
│   }                                                                          │
│                                                                              │
│   pub struct PricingEngine;                                                  │
│                                                                              │
│   impl PricingEngine {                                                       │
│       /// Main calculation entry point                                       │
│       pub fn calculate(input: &BookingInput) -> Result<PricingResult,        │
│   String> {                                                                  │
│           match input.booking_type {                                         │
│               BookingType::Monthly => Self::calculate_monthly(input),        │
│               BookingType::Daily => Self::calculate_daily(input),            │
│               BookingType::Overnight => Self::calculate_overnight(input),    │
│               BookingType::Hourly => Self::calculate_hourly(input),          │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       /// Monthly rate calculation                                           │
│       /// Logic from SkyHotel:                                               │
│       /// - Room charge = base_rate (monthly flat rate)                      │
│       /// - Extra guest charge = (guest_count - 1) * surcharge_per_day *     │
│   days_in_month                                                              │
│       ///   (base capacity = 1 guest included in base rate)                  │
│       /// - Early check-in fee: flat fee if applicable                       │
│       /// - Late checkout fee: flat fee if applicable                        │
│       fn calculate_monthly(input: &BookingInput) -> Result<PricingResult,    │
│   String> {                                                                  │
│           if input.guest_count == 0 {                                        │
│               return Err("Guest count must be at least 1".to_string());      │
│           }                                                                  │
│           if input.days_in_month == 0 || input.days_in_month > 31 {          │
│               return Err("Invalid days_in_month value".to_string());         │
│           }                                                                  │
│                                                                              │
│           // Room charge = monthly flat rate                                 │
│           let room_charge = input.base_rate;                                 │
│                                                                              │
│           // Extra guest: guests beyond base capacity (1)                    │
│           let extra_guests = if input.guest_count > 1 {                      │
│               (input.guest_count - 1) as u32                                 │
│           } else {                                                           │
│               0                                                              │
│           };                                                                 │
│           let extra_guest_charge = input.extra_guest_surcharge_per_day       │
│               * Decimal::from(extra_guests)                                  │
│               * Decimal::from(input.days_in_month);                          │
│                                                                              │
│           // Early check-in / late checkout (flat fee, applied once for      │
│   monthly)                                                                   │
│           let early_checkin_charge = if input.early_checkin {                │
│               input.early_checkin_fee                                        │
│           } else {                                                           │
│               dec!(0)                                                        │
│           };                                                                 │
│                                                                              │
│           let late_checkout_charge = if input.late_checkout {                │
│               input.late_checkout_fee                                        │
│           } else {                                                           │
│               dec!(0)                                                        │
│           };                                                                 │
│                                                                              │
│           // Extra service charges                                           │
│           let extra_charges_total: Decimal = input                           │
│               .extra_charges                                                 │
│               .iter()                                                        │
│               .map(|c| c.amount)                                             │
│               .sum();                                                        │
│                                                                              │
│           // Subtotal before discount/VAT                                    │
│           let subtotal = room_charge                                         │
│               + extra_guest_charge                                           │
│               + early_checkin_charge                                         │
│               + late_checkout_charge                                         │
│               + extra_charges_total;                                         │
│                                                                              │
│           // Discount                                                        │
│           let discount_amount = subtotal * input.discount_percent /          │
│   dec!(100);                                                                 │
│           let after_discount = subtotal - discount_amount;                   │
│                                                                              │
│           // VAT                                                             │
│           let vat_amount = after_discount * input.vat_percent / dec!(100);   │
│           let total = after_discount + vat_amount;                           │
│                                                                              │
│           Ok(PricingResult {                                                 │
│               booking_type: BookingType::Monthly,                            │
│               room_charge,                                                   │
│               extra_guest_charge,                                            │
│               early_checkin_charge,                                          │
│               late_checkout_charge,                                          │
│               extra_charges_total,                                           │
│               subtotal,                                                      │
│               discount_amount,                                               │
│               vat_amount,                                                    │
│               total,                                                         │
│           })                                                                 │
│       }                                                                      │
│                                                                              │
│       fn calculate_daily(input: &BookingInput) -> Result<PricingResult,      │
│   String> {                                                                  │
│           // Placeholder - implemented in other tasks                        │
│           todo!("Daily calculation - see task 6.4/6.5")                      │
