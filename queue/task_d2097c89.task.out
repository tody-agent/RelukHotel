│   ═══════════════════════════════════════════════════════════════════════    │
│       // CASE G3: Monthly rate, 2 guests, early check-in + late checkout     │
│       // Expected: total = base_monthly_rate + extra_guest + early_fee +     │
│   late_fee                                                                   │
│       //                                                                     │
│   ═══════════════════════════════════════════════════════════════════════    │
│       #[test]                                                                │
│       fn test_g3_monthly_two_guests_early_checkin_late_checkout() {          │
│           // Arrange                                                         │
│           let input = make_monthly_input(                                    │
│               2,              // guest_count                                 │
│               dec!(6000000),  // base_monthly_rate: 6,000,000 VND            │
│               dec!(100000),   // extra_guest_surcharge_per_day: 100,000      │
│   VND                                                                        │
│               30,             // days_in_month                               │
│               true,           // early check-in                              │
│               true,           // late checkout                               │
│               dec!(200000),   // early_checkin_fee: 200,000 VND              │
│               dec!(150000),   // late_checkout_fee: 150,000 VND              │
│           );                                                                 │
│                                                                              │
│           // Act                                                             │
│           let result = PricingEngine::calculate(&input);                     │
│                                                                              │
│           // Assert                                                          │
│           assert!(result.is_ok());                                           │
│           let pricing: PricingResult = result.unwrap();                      │
│                                                                              │
│           let expected_room = dec!(6000000);                                 │
│           let expected_extra_guest = dec!(100000) * dec!(30); // 3,000,000   │
│           let expected_early = dec!(200000);                                 │
│           let expected_late = dec!(150000);                                  │
│           let expected_total = expected_room + expected_extra_guest +        │
│   expected_early + expected_late;                                            │
│                                                                              │
│           assert_eq!(pricing.room_charge, expected_room);                    │
│           assert_eq!(pricing.extra_guest_charge, expected_extra_guest);      │
│           assert_eq!(pricing.early_checkin_charge, expected_early);          │
│           assert_eq!(pricing.late_checkout_charge, expected_late);           │
│           assert_eq!(pricing.subtotal, expected_total);                      │
│           assert_eq!(pricing.total, dec!(9350000)); // 6M + 3M + 200K +      │
│   150K                                                                       │
│           assert_eq!(pricing.booking_type, BookingType::Monthly);            │
│       }                                                                      │
│                                                                              │
