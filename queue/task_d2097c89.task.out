│       // CASE G1: Monthly rate, 1 guest, standard room                       │
│       // Expected: total = base_monthly_rate (no surcharge)                  │
│       //                                                                     │
│   ═══════════════════════════════════════════════════════════════════════    │
│       #[test]                                                                │
│       fn test_g1_monthly_single_guest_standard_room() {                      │
│           // Arrange                                                         │
│           let input = make_monthly_input(                                    │
│               1,              // guest_count                                 │
│               dec!(6000000),  // base_monthly_rate: 6,000,000 VND            │
│               dec!(100000),   // extra_guest_surcharge_per_day: 100,000      │
│   VND (not applied for 1 guest)                                              │
│               30,             // days_in_month                               │
│               false,          // no early check-in                           │
│               false,          // no late checkout                            │
│               dec!(0),                                                       │
│               dec!(0),                                                       │
│           );                                                                 │
│                                                                              │
│           // Act                                                             │
│           let result = PricingEngine::calculate(&input);                     │
│                                                                              │
│           // Assert                                                          │
│           assert!(result.is_ok());                                           │
│           let pricing: PricingResult = result.unwrap();                      │
│                                                                              │
│           assert_eq!(pricing.room_charge, dec!(6000000));                    │
│           assert_eq!(pricing.extra_guest_charge, dec!(0));                   │
│           assert_eq!(pricing.early_checkin_charge, dec!(0));                 │
│           assert_eq!(pricing.late_checkout_charge, dec!(0));                 │
│           assert_eq!(pricing.subtotal, dec!(6000000));                       │
│           assert_eq!(pricing.total, dec!(6000000));                          │
│           assert_eq!(pricing.booking_type, BookingType::Monthly);            │
│       }                                                                      │
│                                                                              │
