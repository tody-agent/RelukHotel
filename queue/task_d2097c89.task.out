│       pub base_rate: Decimal,                                                │
│       pub extra_guest_surcharge_per_day: Decimal,                            │
│       pub days_in_month: u32,                                                │
│       pub nights: u32,                                                       │
│       pub early_checkin: bool,                                               │
│       pub late_checkout: bool,                                               │
