│  File: src-tauri/src/pricing/tests/monthly_test.rs                           │
│                                                                              │
│                                                                              │
│   //! Unit tests for Monthly Rate Calculation - Cases G1, G2, G3             │
│   //!                                                                        │
│   //! Business logic (from design.md):                                       │
│   //! - G1: Monthly rate, single guest, standard room → base_monthly_rate    │
│   //! - G2: Monthly rate, 2 guests, standard room → base_monthly_rate +      │
│   extra_guest_surcharge * days_in_month                                      │
│   //! - G3: Monthly rate, 2 guests, with early check-in / late checkout →    │
│   applies surcharges on top of monthly                                       │
│                                                                              │
│   #[cfg(test)]                                                               │
│   mod monthly_pricing_tests {                                                │
│       use crate::pricing::engine::{                                          │
│           BookingInput, BookingType, PricingEngine, PricingResult,           │
│   RoomType,                                                                  │
│           ExtraCharge, ExtraChargeType,                                      │
│       };                                                                     │
│       use rust_decimal::Decimal;                                             │
│       use rust_decimal_macros::dec;                                          │
│                                                                              │
│       /// Helper: create a standard monthly booking input                    │
│       fn make_monthly_input(                                                 │
│           guest_count: u8,                                                   │
│           base_monthly_rate: Decimal,                                        │
│           extra_guest_surcharge_per_day: Decimal,                            │
│           days_in_month: u32,                                                │
│           early_checkin: bool,                                               │
│           late_checkout: bool,                                               │
│           early_checkin_fee: Decimal,                                        │
│           late_checkout_fee: Decimal,                                        │
│       ) -> BookingInput {                                                    │
│           BookingInput {                                                     │
│               booking_type: BookingType::Monthly,                            │
│               room_type: RoomType::Standard,                                 │
│               guest_count,                                                   │
│               base_rate: base_monthly_rate,                                  │
│               extra_guest_surcharge_per_day,                                 │
│               days_in_month,                                                 │
│               nights: days_in_month, // monthly = full month                 │
│               early_checkin,                                                 │
│               late_checkout,                                                 │
│               early_checkin_fee,                                             │
│               late_checkout_fee,                                             │
│               hourly_rate: dec!(0),                                          │
│               hours: 0,                                                      │
│               discount_percent: dec!(0),                                     │
│               vat_percent: dec!(0), // VAT tested separately                 │
│               extra_charges: vec![],                                         │
