│                                                                              │
│       #[test]                                                                │
│       fn b1_b2_b3_tourist_combined_full_scenario() {                         │
│           // Tourist, Deluxe, 3 nights, 1 extra person, early 30%, late      │
│   50%                                                                        │
│           let request = BookingRequest {                                     │
│               guest_type: GuestType::Tourist,                                │
│               room_category: RoomCategory::Deluxe,                           │
│               nights: 3,                                                     │
│               extra_persons: 1,                                              │
│               extra_bed: true,                                               │
│               early_checkin: SurchargeType::Percent30,                       │
│               late_checkout: SurchargeType::Percent50,                       │
│           };                                                                 │
│                                                                              │
│           let result = calculate_price(&request);                            │
│                                                                              │
│           // B1: base = 1,200,000; tourist 10% => effective = 1,320,000      │
│           assert_eq!(result.base_rate_per_night, 1_200_000);                 │
│           assert_eq!(result.effective_rate_per_night, 1_320_000);            │
│           assert_eq!(result.total_room_charge, 3_960_000); // 1.32M * 3      │
│                                                                              │
│           // B2: Deluxe 25% of effective = 330,000 per person per night      │
│           //     1 person * 3 nights = 990,000                               │
│           assert_eq!(result.extra_person_charge, 990_000);                   │
│                                                                              │
│           // B3: early 30% of 1,320,000 = 396,000                            │
│           //     late 50% of 1,320,000 = 660,000                             │
│           assert_eq!(result.early_checkin_charge, 396_000);                  │
│           assert_eq!(result.late_checkout_charge, 660_000);                  │
│                                                                              │
│           // Grand total: 3,960,000 + 990,000 + 396,000 + 660,000 =          │
│   6,006,000                                                                  │
│           assert_eq!(result.grand_total, 6_006_000);                         │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn b1_b2_b3_tourist_suite_max_everything() {                           │
│           // Tourist, Suite, 7 nights, 2 extra persons, early 100%, late     │
│   100%                                                                       │
│           let request = BookingRequest {                                     │
│               guest_type: GuestType::Tourist,                                │
│               room_category: RoomCategory::Suite,                            │
