│       #[test]                                                                │
│       fn b1_tourist_standard_1_night() {                                     │
│           let request = BookingRequest {                                     │
│               guest_type: GuestType::Tourist,                                │
│               room_category: RoomCategory::Standard,                         │
│               nights: 1,                                                     │
│               extra_persons: 0,                                              │
│               extra_bed: false,                                              │
│               early_checkin: SurchargeType::None,                            │
│               late_checkout: SurchargeType::None,                            │
│           };                                                                 │
│                                                                              │
│           let result = calculate_price(&request);                            │
│                                                                              │
│           assert_eq!(result.base_rate_per_night, 500_000);                   │
│           assert_eq!(result.tourist_surcharge_percent, 10.0);                │
│           assert_eq!(result.effective_rate_per_night, 550_000); // 500k +    │
│   10%                                                                        │
│           assert_eq!(result.total_room_charge, 550_000);                     │
│           assert_eq!(result.extra_person_charge, 0);                         │
│           assert_eq!(result.early_checkin_charge, 0);                        │
│           assert_eq!(result.late_checkout_charge, 0);                        │
│           assert_eq!(result.grand_total, 550_000);                           │
│       }                                                                      │
│                                                                              │
│       #[test]                                                                │
│       fn b1_tourist_standard_3_nights() {                                    │
│           let request = BookingRequest {                                     │
│               guest_type: GuestType::Tourist,                                │
│               room_category: RoomCategory::Standard,                         │
│               nights: 3,                                                     │
