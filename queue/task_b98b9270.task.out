│               extra_bed: true,                                               │
│               early_checkin: SurchargeType::Percent100,                      │
│               late_checkout: SurchargeType::Percent100,                      │
│           };                                                                 │
│                                                                              │
│           let result = calculate_price(&request);                            │
│                                                                              │
│           // B1: base = 2,500,000; tourist 10% => effective = 2,750,000      │
│           assert_eq!(result.effective_rate_per_night, 2_750_000);            │
│           assert_eq!(result.total_room_charge, 19_250_000); // 2.75M * 7     │
│                                                                              │
│           // B2: Suite 20% of effective = 550,000 per person per night       │
│           //     2 persons * 7 nights = 7,700,000                            │
│           assert_eq!(result.extra_person_charge, 7_700_000);                 │
│                                                                              │
│           // B3: early 100% = 2,750,000; late 100% = 2,750,000               │
│           assert_eq!(result.early_checkin_charge, 2_750_000);                │
│           assert_eq!(result.late_checkout_charge, 2_750_000);                │
│                                                                              │
│           // Grand total: 19,250,000 + 7,700,000 + 2,750,000 + 2,750,000 =   │
│   32,450,000                                                                 │
│           assert_eq!(result.grand_total, 32_450_000);                        │
│       }                                                                      │
│   }                                                                          │
