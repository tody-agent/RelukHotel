│   // ============================================================            │
│                                                                              │
│   use serde::{Deserialize, Serialize};                                       │
│                                                                              │
│   /// Guest type classification                                              │
│   #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]       │
│   pub enum GuestType {                                                       │
│       /// Khách nội địa                                                      │
│       Domestic,                                                              │
│       /// Khách du lịch (Tourist)                                            │
│       Tourist,                                                               │
│       /// Khách doanh nghiệp                                                 │
│       Corporate,                                                             │
│   }                                                                          │
│                                                                              │
│   /// Room category                                                          │
│   #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]       │
│   pub enum RoomCategory {                                                    │
│       Standard,                                                              │
│       Superior,                                                              │
│       Deluxe,                                                                │
│       Suite,                                                                 │
│   }                                                                          │
│                                                                              │
│   /// Surcharge type for early/late operations                               │
│   #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]       │
│   pub enum SurchargeType {                                                   │
│       /// No surcharge (within standard time)                                │
│       None,                                                                  │
│       /// 30% surcharge (early checkin 9:00-14:00 or late checkout           │
│   12:00-15:00)                                                               │
│       Percent30,                                                             │
│       /// 50% surcharge (early checkin 5:00-9:00 or late checkout            │
│   15:00-18:00)                                                               │
│       Percent50,                                                             │
│       /// 100% surcharge (before 5:00 or after 18:00 — counts as extra       │
│   night)                                                                     │
│       Percent100,                                                            │
│   }                                                                          │
│                                                                              │
│   /// Extra bed / extra person policy                                        │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct ExtraBedPolicy {                                                │
│       /// Whether extra bed is allowed                                       │
│       pub allowed: bool,                                                     │
│       /// Fixed surcharge amount for extra bed (VND)                         │
│       pub fixed_amount: Option<u64>,                                         │
│       /// Percentage surcharge on base rate (if fixed_amount is None)        │
│       pub percent_of_base: Option<f64>,                                      │
│       /// Maximum extra persons allowed                                      │
│       pub max_extra_persons: u8,                                             │
│   }                                                                          │
│                                                                              │
│   /// Booking request input                                                  │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct BookingRequest {                                                │
│       pub guest_type: GuestType,                                             │
│       pub room_category: RoomCategory,                                       │
│       /// Number of nights                                                   │
│       pub nights: u32,                                                       │
│       /// Number of extra persons (beyond room capacity)                     │
│       pub extra_persons: u8,                                                 │
│       /// Whether extra bed is requested                                     │
│       pub extra_bed: bool,                                                   │
│       /// Early check-in surcharge type                                      │
│       pub early_checkin: SurchargeType,                                      │
│       /// Late check-out surcharge type                                      │
│       pub late_checkout: SurchargeType,                                      │
│   }                                                                          │
│                                                                              │
│   /// Pricing breakdown result                                               │
│   #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]                 │
│   pub struct PricingResult {                                                 │
│       /// Base room rate per night (VND)                                     │
│       pub base_rate_per_night: u64,                                          │
│       /// Tourist surcharge percentage applied (e.g., 10% for tourist)       │
│       pub tourist_surcharge_percent: f64,                                    │
│       /// Effective rate per night after tourist surcharge                   │
│       pub effective_rate_per_night: u64,                                     │
│       /// Total room charge (effective_rate * nights)                        │
│       pub total_room_charge: u64,                                            │
│       /// Extra bed / extra person charge total                              │
│       pub extra_person_charge: u64,                                          │
│       /// Early check-in surcharge                                           │
│       pub early_checkin_charge: u64,                                         │
│       /// Late check-out surcharge                                           │
│       pub late_checkout_charge: u64,                                         │
│       /// Grand total                                                        │
│       pub grand_total: u64,                                                  │
│   }                                                                          │
