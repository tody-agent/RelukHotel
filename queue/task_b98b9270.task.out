│   // ============================================================            │
│   // File: src-tauri/src/pricing/engine.rs                                   │
│   // ============================================================            │
│                                                                              │
│   use super::types::*;                                                       │
│                                                                              │
│   /// Base rates per night by room category (VND)                            │
│   /// These would typically come from DB/config, hardcoded here for engine   │
│   logic                                                                      │
│   pub fn get_base_rate(room_category: RoomCategory) -> u64 {                 │
│       match room_category {                                                  │
│           RoomCategory::Standard => 500_000,                                 │
│           RoomCategory::Superior => 800_000,                                 │
│           RoomCategory::Deluxe => 1_200_000,                                 │
│           RoomCategory::Suite => 2_500_000,                                  │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// Tourist surcharge percentage (phụ thu khách du lịch)                   │
│   /// In Vietnam hotel systems, tourist guests often have a 10% surcharge    │
│   pub fn get_tourist_surcharge_percent(guest_type: GuestType) -> f64 {       │
│       match guest_type {                                                     │
│           GuestType::Tourist => 10.0, // 10% phụ thu khách du lịch           │
│           GuestType::Domestic => 0.0,                                        │
│           GuestType::Corporate => 0.0, // Corporate has separate discount    │
│   logic                                                                      │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// Extra bed policy by room category                                      │
│   pub fn get_extra_bed_policy(room_category: RoomCategory) ->                │
│   ExtraBedPolicy {                                                           │
│       match room_category {                                                  │
│           RoomCategory::Standard => ExtraBedPolicy {                         │
│               allowed: true,                                                 │
│               fixed_amount: Some(200_000),                                   │
│               percent_of_base: None,                                         │
│               max_extra_persons: 1,                                          │
│           },                                                                 │
│           RoomCategory::Superior => ExtraBedPolicy {                         │
│               allowed: true,                                                 │
│               fixed_amount: Some(250_000),                                   │
│               percent_of_base: None,                                         │
│               max_extra_persons: 1,                                          │
│           },                                                                 │
│           RoomCategory::Deluxe => ExtraBedPolicy {                           │
│               allowed: true,                                                 │
│               fixed_amount: None,                                            │
│               percent_of_base: Some(25.0), // 25% of base rate               │
│               max_extra_persons: 2,                                          │
│           },                                                                 │
│           RoomCategory::Suite => ExtraBedPolicy {                            │
│               allowed: true,                                                 │
│               fixed_amount: None,                                            │
│               percent_of_base: Some(20.0), // 20% of base rate               │
│               max_extra_persons: 2,                                          │
│           },                                                                 │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// Convert surcharge type to percentage multiplier                        │
│   fn surcharge_to_percent(surcharge: SurchargeType) -> f64 {                 │
│       match surcharge {                                                      │
│           SurchargeType::None => 0.0,                                        │
│           SurchargeType::Percent30 => 30.0,                                  │
│           SurchargeType::Percent50 => 50.0,                                  │
│           SurchargeType::Percent100 => 100.0,                                │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│   /// Main pricing calculation engine                                        │
│   /// Implements the SkyHotel pricing logic converted to Rust                │
│   pub fn calculate_price(request: &BookingRequest) -> PricingResult {        │
│       // Step 1: Get base rate                                               │
│       let base_rate_per_night = get_base_rate(request.room_category);        │
│                                                                              │
│       // Step 2: Apply tourist surcharge                                     │
│       let tourist_surcharge_percent =                                        │
│   get_tourist_surcharge_percent(request.guest_type);                         │
│       let surcharge_amount = (base_rate_per_night as f64 *                   │
│   tourist_surcharge_percent / 100.0) as u64;                                 │
│       let effective_rate_per_night = base_rate_per_night +                   │
│   surcharge_amount;                                                          │
│                                                                              │
│       // Step 3: Calculate total room charge                                 │
│       let total_room_charge = effective_rate_per_night * request.nights as   │
│   u64;                                                                       │
│                                                                              │
│       // Step 4: Calculate extra person/bed charge                           │
│       let extra_person_charge = if request.extra_bed &&                      │
│   request.extra_persons > 0 {                                                │
│           let policy = get_extra_bed_policy(request.room_category);          │
│           if !policy.allowed {                                               │
│               0                                                              │
│           } else {                                                           │
│               let capped_persons =                                           │
│   request.extra_persons.min(policy.max_extra_persons);                       │
│               let per_person_charge = if let Some(fixed) =                   │
│   policy.fixed_amount {                                                      │
│                   fixed                                                      │
│               } else if let Some(percent) = policy.percent_of_base {         │
│                   (effective_rate_per_night as f64 * percent / 100.0) as     │
│   u64                                                                        │
│               } else {                                                       │
│                   0                                                          │
│               };                                                             │
│               per_person_charge * capped_persons as u64 * request.nights     │
│   as u64                                                                     │
│           }                                                                  │
│       } else {                                                               │
│           0                                                                  │
│       };                                                                     │
│                                                                              │
│       // Step 5: Early check-in surcharge (based on 1 night effective        │
│   rate)                                                                      │
│       let early_checkin_percent =                                            │
│   surcharge_to_percent(request.early_checkin);                               │
│       let early_checkin_charge = (effective_rate_per_night as f64 *          │
│   early_checkin_percent / 100.0) as u64;                                     │
│                                                                              │
│       // Step 6: Late check-out surcharge (based on 1 night effective        │
│   rate)                                                                      │
│       let late_checkout_percent =                                            │
│   surcharge_to_percent(request.late_checkout);                               │
│       let late_checkout_charge = (effective_rate_per_night as f64 *          │
│   late_checkout_percent / 100.0) as u64;                                     │
│                                                                              │
│       // Step 7: Grand total                                                 │
│       let grand_total = total_room_charge + extra_person_charge +            │
│   early_checkin_charge + late_checkout_charge;                               │
│                                                                              │
│       PricingResult {                                                        │
│           base_rate_per_night,                                               │
│           tourist_surcharge_percent,                                         │
│           effective_rate_per_night,                                          │
│           total_room_charge,                                                 │
│           extra_person_charge,                                               │
│           early_checkin_charge,                                              │
│           late_checkout_charge,                                              │
│           grand_total,                                                       │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│                                                                              │
