│                                                                              │
│  File: src-tauri/src/pricing/property_tests.rs ← FILE CHÍNH CỦA TASK 6.8     │
│                                                                              │
│                                                                              │
│   //! Task 6.8: Property-based test - tổng line_items luôn = total           │
│   //!                                                                        │
│   //! Sử dụng proptest để generate hàng nghìn input ngẫu nhiên và verify     │
│   //! invariant: sum(line_items[i].subtotal) == total cho MỌI trường hợp.    │
│                                                                              │
│   #[cfg(test)]                                                               │
│   mod tests {                                                                │
│       use proptest::prelude::*;                                              │
│       use crate::pricing::engine::calculate_pricing;                         │
│       use crate::pricing::types::*;                                          │
│                                                                              │
│       /// Strategy để generate PricingInput hợp lệ cho khách sạn VN          │
│       fn pricing_input_strategy() -> impl Strategy<Value = PricingInput> {   │
│           (                                                                  │
│               // room_rate: 100_000 - 50_000_000 VND (100k - 50tr)           │
│               100_000i64..=50_000_000i64,                                    │
│               // num_nights: 1 - 30                                          │
│               1u32..=30u32,                                                  │
│               // num_extra_beds: 0 - 3                                       │
│               0u32..=3u32,                                                   │
│               // extra_bed_rate: 0 - 2_000_000 VND                           │
│               0i64..=2_000_000i64,                                           │
│               // include_breakfast: bool                                     │
│               any::<bool>(),                                                 │
│               // breakfast_rate: 50_000 - 500_000 VND                        │
│               50_000i64..=500_000i64,                                        │
│               // num_guests_breakfast: 1 - 6                                 │
│               1u32..=6u32,                                                   │
│               // service_fee_percent: 0.0 - 15.0                             │
│               0.0f64..=15.0f64,                                              │
│               // vat_percent: 0.0 - 10.0                                     │
│               0.0f64..=10.0f64,                                              │
│               // city_tax: 0 - 500_000 VND                                   │
│               0i64..=500_000i64,                                             │
│           )                                                                  │
│               .prop_flat_map(|tuple| {                                       │
│                   let (                                                      │
│                       room_rate,                                             │
│                       num_nights,                                            │
│                       num_extra_beds,                                        │
│                       extra_bed_rate,                                        │
│                       include_breakfast,                                     │
│                       breakfast_rate,                                        │
│                       num_guests_breakfast,                                  │
│                       service_fee_percent,                                   │
│                       vat_percent,                                           │
│                       city_tax,                                              │
│                   ) = tuple;                                                 │
│                                                                              │
│                   // Generate thêm các field còn lại                         │
│                   (                                                          │
│                       Just(room_rate),                                       │
│                       Just(num_nights),                                      │
│                       Just(num_extra_beds),                                  │
│                       Just(extra_bed_rate),                                  │
│                       Just(include_breakfast),                               │
│                       Just(breakfast_rate),                                  │
│                       Just(num_guests_breakfast),                            │
│                       Just(service_fee_percent),                             │
│                       Just(vat_percent),                                     │
│                       Just(city_tax),                                        │
│                       // discount_percent: 0.0 - 50.0                        │
│                       0.0f64..=50.0f64,                                      │
│                       // early_checkin_fee: 0 or 100_000 - 1_000_000         │
│                       prop_oneof![                                           │
│                           Just(0i64),                                        │
│                           100_000i64..=1_000_000i64,                         │
│                       ],                                                     │
│                       // late_checkout_fee: 0 or 100_000 - 1_000_000         │
│                       prop_oneof![                                           │
│                           Just(0i64),                                        │
│                           100_000i64..=1_000_000i64,                         │
│                       ],                                                     │
│                       // special_surcharge: 0 or 50_000 - 5_000_000          │
│                       prop_oneof![                                           │
│                           Just(0i64),                                        │
│                           50_000i64..=5_000_000i64,                          │
│                       ],                                                     │
│                   )                                                          │
│               })                                                             │
│               .prop_map(|tuple| {                                            │
│                   PricingInput {                                             │
│                       room_rate: tuple.0,                                    │
│                       num_nights: tuple.1,                                   │
│                       num_extra_beds: tuple.2,                               │
│                       extra_bed_rate: tuple.3,                               │
│                       include_breakfast: tuple.4,                            │
│                       breakfast_rate: tuple.5,                               │
│                       num_guests_breakfast: tuple.6,                         │
│                       service_fee_percent: tuple.7,                          │
│                       vat_percent: tuple.8,                                  │
│                       city_tax: tuple.9,                                     │
│                       discount_percent: tuple.10,                            │
│                       early_checkin_fee: tuple.11,                           │
│                       late_checkout_fee: tuple.12,                           │
│                       special_surcharge: tuple.13,                           │
│                   }                                                          │
│               })                                                             │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 1 (CHÍNH): Tổng line_items.subtotal == total               │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(10_000))]            │
│                                                                              │
│           #[test]                                                            │
│           fn prop_sum_line_items_equals_total(input in                       │
│   pricing_input_strategy()) {                                                │
│               let result = calculate_pricing(&input);                        │
│                                                                              │
│               let sum_of_line_items: Money = result                          │
│                   .line_items                                                │
│                   .iter()                                                    │
│                   .map(|item| item.subtotal)                                 │
│                   .sum();                                                    │
│                                                                              │
│               prop_assert_eq!(                                               │
│                   sum_of_line_items,                                         │
│                   result.total,                                              │
│                   "INVARIANT VIOLATED: sum(line_items) = {} but total =      │
│   {}\nInput: {:?}\nLine items: {:?}",                                        │
│                   sum_of_line_items,                                         │
│                   result.total,                                              │
│                   input,                                                     │
│                   result.line_items                                          │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 2: Total luôn >= 0 khi discount <= 100%                    │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(5_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_total_non_negative_with_reasonable_discount(               │
│               input in pricing_input_strategy()                              │
│                   .prop_filter("discount must be <= 100%", |i|               │
│   i.discount_percent <= 100.0)                                               │
│           ) {                                                                │
│               let result = calculate_pricing(&input);                        │
│                                                                              │
│               // Với discount hợp lệ (<=100%), total phải >= 0               │
│               // Trừ khi discount_percent > tổng phụ phí / pre_tax ratio     │
│               // Nhưng trong thực tế VN, total nên >= 0                      │
│               prop_assert!(                                                  │
│                   result.total >= 0,                                         │
│                   "Total should be non-negative, got: {}. Input: {:?}",      │
│                   result.total,                                              │
│                   input                                                      │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 3: Mỗi line_item có subtotal = amount * quantity (trừ %    │
│   items)                                                                     │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(5_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_line_item_subtotal_consistency(input in                    │
│   pricing_input_strategy()) {                                                │
│               let result = calculate_pricing(&input);                        │
│                                                                              │
│               for item in &result.line_items {                               │
│                   match item.kind {                                          │
│                       // Các item tính theo percentage không tuân theo       │
│   amount * quantity                                                          │
│                       LineItemKind::ServiceFee                               │
│                       | LineItemKind::Vat                                    │
│                       | LineItemKind::Discount => {                          │
│                           // Chỉ verify quantity = 1 cho percentage items    │
│                           prop_assert_eq!(                                   │
│                               item.quantity, 1,                              │
│                               "Percentage-based items should have quantity   │
│   = 1"                                                                       │
│                           );                                                 │
│                       }                                                      │
│                       // Các item khác: subtotal = amount * quantity         │
│                       _ => {                                                 │
│                           prop_assert_eq!(                                   │
│                               item.subtotal,                                 │
│                               item.amount * item.quantity as i64,            │
│                               "LineItem {:?}: subtotal ({}) != amount ({})   │
│   * quantity ({})",                                                          │
│                               item.kind,                                     │
│                               item.subtotal,                                 │
│                               item.amount,                                   │
│                               item.quantity                                  │
│                           );                                                 │
│                       }                                                      │
│                   }                                                          │
│               }                                                              │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 4: Thêm đêm luôn tăng total (monotonicity)                 │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(3_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_more_nights_means_higher_total(input in                    │
│   pricing_input_strategy()) {                                                │
│               prop_assume!(input.num_nights < 30);                           │
│               prop_assume!(input.room_rate > 0);                             │
│                                                                              │
│               let mut input_plus_one = input.clone();                        │
│               input_plus_one.num_nights += 1;                                │
│                                                                              │
│               let result_base = calculate_pricing(&input);                   │
│               let result_plus = calculate_pricing(&input_plus_one);          │
│                                                                              │
│               prop_assert!(                                                  │
│                   result_plus.total >= result_base.total,                    │
│                   "Adding a night should not decrease total. Base: {}, +1    │
│   night: {}",                                                                │
│                   result_base.total,                                         │
│                   result_plus.total                                          │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 5: Không có discount => total >= room_charge               │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(3_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_no_discount_total_gte_room_charge(                         │
│               input in pricing_input_strategy()                              │
│                   .prop_map(|mut i| { i.discount_percent = 0.0; i })         │
│           ) {                                                                │
│               let result = calculate_pricing(&input);                        │
│               let room_charge = input.room_rate * input.num_nights as i64;   │
│                                                                              │
│               prop_assert!(                                                  │
│                   result.total >= room_charge,                               │
│                   "Without discount, total ({}) should be >= room charge     │
│   ({})",                                                                     │
│                   result.total,                                              │
│                   room_charge                                                │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 6: Currency luôn là VND                                    │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(1_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_currency_always_vnd(input in pricing_input_strategy()) {   │
│               let result = calculate_pricing(&input);                        │
│               prop_assert_eq!(result.currency, "VND");                       │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 7: line_items không rỗng (ít nhất có room charge)          │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(3_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_at_least_one_line_item(input in                            │
│   pricing_input_strategy()) {                                                │
│               let result = calculate_pricing(&input);                        │
│                                                                              │
│               prop_assert!(                                                  │
│                   !result.line_items.is_empty(),                             │
│                   "There should always be at least one line item (room       │
│   charge). Input: {:?}",                                                     │
│                   input                                                      │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 8: Idempotency - cùng input luôn cho cùng output           │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(2_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_idempotent_calculation(input in                            │
│   pricing_input_strategy()) {                                                │
│               let result1 = calculate_pricing(&input);                       │
│               let result2 = calculate_pricing(&input);                       │
│                                                                              │
│               prop_assert_eq!(                                               │
│                   result1.total,                                             │
│                   result2.total,                                             │
│                   "Same input must produce same total"                       │
│               );                                                             │
│               prop_assert_eq!(                                               │
│                   result1.line_items.len(),                                  │
│                   result2.line_items.len(),                                  │
│                   "Same input must produce same number of line items"        │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // Edge case strategy: zero-values                                     │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       fn zero_heavy_strategy() -> impl Strategy<Value = PricingInput> {      │
│           (                                                                  │
│               prop_oneof![Just(0i64), 100_000i64..=1_000_000i64],            │
│               1u32..=5u32,                                                   │
│               0u32..=1u32,                                                   │
│               prop_oneof![Just(0i64), 100_000i64..=500_000i64],              │
│               any::<bool>(),                                                 │
│               prop_oneof![Just(0i64), 50_000i64..=200_000i64],               │
│               0u32..=2u32,                                                   │
│               prop_oneof![Just(0.0f64), 5.0f64..=10.0f64],                   │
│               prop_oneof![Just(0.0f64), 8.0f64..=10.0f64],                   │
│               prop_oneof![Just(0i64), 10_000i64..=100_000i64],               │
│               prop_oneof![Just(0.0f64), 10.0f64..=50.0f64],                  │
│               Just(0i64),                                                    │
│               Just(0i64),                                                    │
│               Just(0i64),                                                    │
│           )                                                                  │
│               .prop_map(|t| PricingInput {                                   │
│                   room_rate: t.0,                                            │
│                   num_nights: t.1,                                           │
│                   num_extra_beds: t.2,                                       │
│                   extra_bed_rate: t.3,                                       │
│                   include_breakfast: t.4,                                    │
│                   breakfast_rate: t.5,                                       │
│                   num_guests_breakfast: t.6,                                 │
│                   service_fee_percent: t.7,                                  │
│                   vat_percent: t.8,                                          │
│                   city_tax: t.9,                                             │
│                   discount_percent: t.10,                                    │
│                   early_checkin_fee: t.11,                                   │
│                   late_checkout_fee: t.12,                                   │
│                   special_surcharge: t.13,                                   │
│               })                                                             │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 9: Edge cases - invariant vẫn giữ với giá trị 0            │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(5_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_sum_equals_total_edge_cases(input in                       │
│   zero_heavy_strategy()) {                                                   │
│               let result = calculate_pricing(&input);                        │
│                                                                              │
│               let sum_of_line_items: Money = result                          │
│                   .line_items                                                │
│                   .iter()                                                    │
│                   .map(|item| item.subtotal)                                 │
│                   .sum();                                                    │
│                                                                              │
│               prop_assert_eq!(                                               │
│                   sum_of_line_items,                                         │
│                   result.total,                                              │
│                   "INVARIANT VIOLATED (edge case): sum = {} but total =      │
│   {}",                                                                       │
│                   sum_of_line_items,                                         │
│                   result.total                                               │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│                                                                              │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       // PROPERTY 10: Maximum stress - giá trị rất lớn, invariant vẫn giữ    │
│       //                                                                     │
│   ========================================================================   │
│   =                                                                          │
│       proptest! {                                                            │
│           #![proptest_config(ProptestConfig::with_cases(2_000))]             │
│                                                                              │
│           #[test]                                                            │
│           fn prop_sum_equals_total_large_values(                             │
│               room_rate in 10_000_000i64..=100_000_000i64,  // 10tr -        │
│   100tr VND/đêm (suite)                                                      │
│               num_nights in 1u32..=30u32,                                    │
│               discount in 0.0f64..=30.0f64,                                  │
│               service_fee in 0.0f64..=15.0f64,                               │
│               vat in 0.0f64..=10.0f64,                                       │
│           ) {                                                                │
│               let input = PricingInput {                                     │
│                   room_rate,                                                 │
│                   num_nights,                                                │
│                   num_extra_beds: 2,                                         │
│                   extra_bed_rate: 1_500_000,                                 │
│                   include_breakfast: true,                                   │
│                   breakfast_rate: 350_000,                                   │
│                   num_guests_breakfast: 4,                                   │
│                   service_fee_percent: service_fee,                          │
│                   vat_percent: vat,                                          │
│                   city_tax: 200_000,                                         │
│                   discount_percent: discount,                                │
│                   early_checkin_fee: 500_000,                                │
│                   late_checkout_fee: 700_000,                                │
│                   special_surcharge: 2_000_000,                              │
│               };                                                             │
│                                                                              │
│               let result = calculate_pricing(&input);                        │
│                                                                              │
│               let sum_of_line_items: Money = result                          │
│                   .line_items                                                │
│                   .iter()                                                    │
│                   .map(|item| item.subtotal)                                 │
│                   .sum();                                                    │
│                                                                              │
│               prop_assert_eq!(                                               │
│                   sum_of_line_items,                                         │
│                   result.total,                                              │
│                   "INVARIANT VIOLATED (large values): sum = {} but total =   │
│   {}",                                                                       │
│                   sum_of_line_items,                                         │
│                   result.total                                               │
│               );                                                             │
│           }                                                                  │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│                                                                              │
│  --------------------------------------------------------------------------  │
│                                                                              │
│  Hướng dẫn gắn code                                                          │
│                                                                              │
│  1. Cấu trúc thư mục                                                         │
│                                                                              │
│                                                                              │
│   src-tauri/                                                                 │
│   ├── Cargo.toml              ← Thêm proptest vào [dev-dependencies]         │
│   └── src/                                                                   │
│       ├── main.rs             ← Thêm `mod pricing;`                          │
│       └── pricing/                                                           │
│           ├── mod.rs          ← Module declarations                          │
│           ├── types.rs        ← Struct definitions                           │
│           ├── engine.rs       ← Core pricing logic                           │
│           └── property_tests.rs  ← ★ FILE TEST TASK 6.8                      │
│                                                                              │
│                                                                              │
│  2. Thêm vào Cargo.toml                                                      │
│                                                                              │
│                                                                              │
│   [dev-dependencies]                                                         │
│   proptest = "1.4"                                                           │
│                                                                              │
│                                                                              │
│  3. Thêm vào src-tauri/src/main.rs (hoặc lib.rs)                             │
│                                                                              │
│                                                                              │
│   mod pricing;                                                               │
│                                                                              │
│                                                                              │
│  4. Chạy test                                                                │
│                                                                              │
│                                                                              │
│   cd src-tauri                                                               │
│   cargo test pricing::property_tests -- --nocapture                          │
│                                                                              │
│                                                                              │
│  Hoặc chạy riêng property test chính:                                        │
│                                                                              │
│                                                                              │
│   cargo test prop_sum_line_items_equals_total -- --nocapture                 │
│                                                                              │
│                                                                              │
│  5. Chạy với nhiều cases hơn (stress test)                                   │
│                                                                              │
│                                                                              │
│   PROPTEST_CASES=100000 cargo test prop_sum_line_items_equals_total --       │
│   --nocapture                                                                │
│                                                                              │
│                                                                              │
│  --------------------------------------------------------------------------  │
│                                                                              │
│  Tóm tắt Properties đã test                                                  │
│                                                                              │
│                                                                              │
│   #   Property              Mô tả                                            │
│   ────────────────────────────────────────────────────────────────────────   │
│   1   sum == total          ★ CHÍNH: Tổng subtotal của mọi line_items luôn   │
│                             bằng total                                       │
│   2   total >= 0            Với discount hợp lệ, total không âm              │
│   3   subtotal consistency  amount * quantity = subtotal cho non-% items     │
│   4   monotonicity          Thêm đêm → total tăng                            │
│   5   no discount floor     Không giảm giá → total >= room charge            │
│   6   currency = VND        Luôn trả về VND                                  │
│   7   non-empty             Luôn có ít nhất 1 line item                      │
│   8   idempotent            Cùng input → cùng output                         │
│   9   edge cases            Invariant giữ với giá trị 0                      │
│   10  large values          Invariant giữ với giá trị lớn (overflow check)   │
│                                                                              │
│                                                                              │
│  Property #1 là core invariant của task 6.8: sum(line_items[i].subtotal) ==  │
│  total phải đúng cho mọi input ngẫu nhiên.                                   │
│                                                                              │
╰──────────────────────────────────────────────────────────────────────────────╯
