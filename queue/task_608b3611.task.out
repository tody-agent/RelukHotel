│       RoomCharge,                                                            │
│       ExtraBed,                                                              │
│       Breakfast,                                                             │
│       ServiceFee,                                                            │
│       Vat,                                                                   │
│       CityTax,                                                               │
│       Discount,                                                              │
│       EarlyCheckIn,                                                          │
│       LateCheckOut,                                                          │
│       SpecialSurcharge,                                                      │
│   }                                                                          │
│                                                                              │
