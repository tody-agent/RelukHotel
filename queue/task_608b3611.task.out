│   pub struct PricingResult {                                                 │
│       pub line_items: Vec<LineItem>,                                         │
│       pub total: Money,                                                      │
│       pub currency: String,                                                  │
│   }                                                                          │
│                                                                              │
│   /// Input cho pricing engine                                               │
│   #[derive(Debug, Clone, Serialize, Deserialize)]                            │
│   pub struct PricingInput {                                                  │
│       pub room_rate: Money,                                                  │
│       pub num_nights: u32,                                                   │
│       pub num_extra_beds: u32,                                               │
│       pub extra_bed_rate: Money,                                             │
│       pub include_breakfast: bool,                                           │
│       pub breakfast_rate: Money,                                             │
│       pub num_guests_breakfast: u32,                                         │
│       pub service_fee_percent: f64,   // 0.0 - 15.0                          │
│       pub vat_percent: f64,           // 0.0 - 10.0                          │
│       pub city_tax: Money,            // flat amount                         │
│       pub discount_percent: f64,      // 0.0 - 100.0                         │
│       pub early_checkin_fee: Money,                                          │
│       pub late_checkout_fee: Money,                                          │
│       pub special_surcharge: Money,                                          │
│   }                                                                          │
