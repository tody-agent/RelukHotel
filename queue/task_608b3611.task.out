│       pub kind: LineItemKind,                                                │
│       pub description: String,                                               │
│       pub amount: Money,                                                     │
│       pub quantity: u32,                                                     │
│       pub subtotal: Money, // amount * quantity (hoặc tính theo logic        │
│   riêng)                                                                     │
│   }                                                                          │
│                                                                              │
│   /// Kết quả tính giá từ Pricing Engine                                     │
