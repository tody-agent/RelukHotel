│                                                                              │
│  File: src-tauri/src/pricing/engine.rs                                       │
│                                                                              │
│                                                                              │
│   use super::types::*;                                                       │
│                                                                              │
│   /// Core pricing calculation - chuyển đổi logic tính giá SkyHotel sang     │
│   Rust                                                                       │
│   ///                                                                        │
│   /// INVARIANT: sum(line_items[i].subtotal) == total                        │
│   /// Đây là property chính mà property-based test sẽ verify.                │
│   pub fn calculate_pricing(input: &PricingInput) -> PricingResult {          │
│       let mut line_items: Vec<LineItem> = Vec::new();                        │
│                                                                              │
│       // 1. Room charge                                                      │
│       let room_subtotal = input.room_rate * input.num_nights as i64;         │
│       if room_subtotal != 0 {                                                │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::RoomCharge,                                │
│               description: format!("{} đêm x {} VND", input.num_nights,      │
│   input.room_rate),                                                          │
│               amount: input.room_rate,                                       │
│               quantity: input.num_nights,                                    │
│               subtotal: room_subtotal,                                       │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 2. Extra bed                                                        │
│       let extra_bed_subtotal = input.extra_bed_rate * input.num_extra_beds   │
│   as i64 * input.num_nights as i64;                                          │
│       if extra_bed_subtotal != 0 {                                           │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::ExtraBed,                                  │
│               description: format!("{} giường phụ x {} đêm",                 │
│   input.num_extra_beds, input.num_nights),                                   │
│               amount: input.extra_bed_rate,                                  │
│               quantity: input.num_extra_beds * input.num_nights,             │
│               subtotal: extra_bed_subtotal,                                  │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 3. Breakfast                                                        │
│       let breakfast_subtotal = if input.include_breakfast {                  │
│           input.breakfast_rate * input.num_guests_breakfast as i64 *         │
│   input.num_nights as i64                                                    │
│       } else {                                                               │
│           0                                                                  │
│       };                                                                     │
│       if breakfast_subtotal != 0 {                                           │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::Breakfast,                                 │
│               description: format!("Bữa sáng {} khách x {} ngày",            │
│   input.num_guests_breakfast, input.num_nights),                             │
│               amount: input.breakfast_rate,                                  │
│               quantity: input.num_guests_breakfast * input.num_nights,       │
│               subtotal: breakfast_subtotal,                                  │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 4. Early check-in                                                   │
│       if input.early_checkin_fee != 0 {                                      │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::EarlyCheckIn,                              │
│               description: "Phụ phí nhận phòng sớm".to_string(),             │
│               amount: input.early_checkin_fee,                               │
│               quantity: 1,                                                   │
│               subtotal: input.early_checkin_fee,                             │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 5. Late check-out                                                   │
│       if input.late_checkout_fee != 0 {                                      │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::LateCheckOut,                              │
│               description: "Phụ phí trả phòng muộn".to_string(),             │
│               amount: input.late_checkout_fee,                               │
│               quantity: 1,                                                   │
│               subtotal: input.late_checkout_fee,                             │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 6. Special surcharge                                                │
│       if input.special_surcharge != 0 {                                      │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::SpecialSurcharge,                          │
│               description: "Phụ thu đặc biệt (lễ, Tết, sự                    │
│   kiện)".to_string(),                                                        │
│               amount: input.special_surcharge,                               │
│               quantity: 1,                                                   │
│               subtotal: input.special_surcharge,                             │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // Subtotal trước thuế/phí dịch vụ                                     │
│       let pre_tax_subtotal: Money = line_items.iter().map(|li|               │
│   li.subtotal).sum();                                                        │
│                                                                              │
│       // 7. Discount (trên pre_tax_subtotal)                                 │
│       let discount_amount = if input.discount_percent > 0.0 {                │
│           // Làm tròn xuống (floor) để tránh sai lệch                        │
│           ((pre_tax_subtotal as f64) * input.discount_percent /              │
│   100.0).floor() as Money                                                    │
│       } else {                                                               │
│           0                                                                  │
│       };                                                                     │
│       if discount_amount != 0 {                                              │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::Discount,                                  │
│               description: format!("Giảm giá {}%",                           │
│   input.discount_percent),                                                   │
│               amount: -discount_amount,                                      │
│               quantity: 1,                                                   │
│               subtotal: -discount_amount, // Âm vì là giảm giá               │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       let after_discount = pre_tax_subtotal - discount_amount;               │
│                                                                              │
│       // 8. Service fee (trên after_discount)                                │
│       let service_fee = if input.service_fee_percent > 0.0 {                 │
│           ((after_discount as f64) * input.service_fee_percent /             │
│   100.0).floor() as Money                                                    │
│       } else {                                                               │
│           0                                                                  │
│       };                                                                     │
│       if service_fee != 0 {                                                  │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::ServiceFee,                                │
│               description: format!("Phí dịch vụ {}%",                        │
│   input.service_fee_percent),                                                │
│               amount: service_fee,                                           │
│               quantity: 1,                                                   │
│               subtotal: service_fee,                                         │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 9. VAT (trên after_discount + service_fee)                          │
│       let taxable_amount = after_discount + service_fee;                     │
│       let vat_amount = if input.vat_percent > 0.0 {                          │
│           ((taxable_amount as f64) * input.vat_percent / 100.0).floor() as   │
│   Money                                                                      │
│       } else {                                                               │
│           0                                                                  │
│       };                                                                     │
│       if vat_amount != 0 {                                                   │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::Vat,                                       │
│               description: format!("VAT {}%", input.vat_percent),            │
│               amount: vat_amount,                                            │
│               quantity: 1,                                                   │
│               subtotal: vat_amount,                                          │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // 10. City tax (flat)                                                 │
│       if input.city_tax != 0 {                                               │
│           line_items.push(LineItem {                                         │
│               kind: LineItemKind::CityTax,                                   │
│               description: "Thuế thành phố".to_string(),                     │
│               amount: input.city_tax,                                        │
│               quantity: 1,                                                   │
│               subtotal: input.city_tax,                                      │
│           });                                                                │
│       }                                                                      │
│                                                                              │
│       // TOTAL = sum of all line_items subtotals                             │
│       let total: Money = line_items.iter().map(|li| li.subtotal).sum();      │
│                                                                              │
│       PricingResult {                                                        │
│           line_items,                                                        │
│           total,                                                             │
│           currency: "VND".to_string(),                                       │
│       }                                                                      │
│   }                                                                          │
│                                                                              │
│                                                                              │
